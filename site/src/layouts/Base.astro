---
import '../styles/global.css';
import { site } from '../content/site';
import { loadContact } from '../lib/settings';
import { defaultMeta, type Meta } from '../content/seo';

interface Props {
  meta?: Meta;
  /** Canonical path, e.g. "/gfrc". Defaults to the current URL's pathname. */
  path?: string;
  /** Adds JSON-LD beyond the sitewide Organization node. */
  jsonLd?: Record<string, unknown>[];
  bodyClass?: string;
}

const { meta = defaultMeta, path, jsonLd = [], bodyClass = '' } = Astro.props;

const contact = await loadContact(Astro.locals);
const canonicalPath = path ?? Astro.url.pathname;
const canonical = new URL(canonicalPath, site.url).href;

// A workers.dev deploy is staging and must stay out of the index, or it will
// compete with www.alicore.in for identical copy once that goes live. The
// meta tag, not robots.txt, is what actually de-indexes: a disallowed page can
// still be indexed from a link, and the crawler never sees the directive.
// robots.txt therefore permits crawling on staging so this tag is read.
const isStaging = /\.workers\.dev$/i.test(new URL(site.url).hostname);

// Sitewide Organization node. Deliberately carries no rating, certification or
// award properties -- none of that is verified. See the brand guidelines.
const organization: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Alicore',
  url: site.url,
  slogan: site.tagline,
  description:
    'Architectural products manufacturer specializing in GFRC and FRP panels, jalis, cornices, columns and custom architectural elements.',
  telephone: contact.phoneHref.replace('tel:', ''),
};
if (contact.email) organization.email = contact.email;

const graph = [organization, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    {isStaging && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alicore" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />

    <meta name="theme-color" content="#12110F" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="al-skip-link" href="#main">Skip to content</a>
    <slot />

    <!--
      Scroll reveal for [data-reveal] elements.

      The flag is set here rather than in the stylesheet so the hidden starting
      state only ever exists when the script that clears it is running. If this
      never executes -- blocked, errored, an old browser -- the attribute is
      absent, the opacity:0 rules never match, and every panel renders in its
      final state. An animation is worth having; it is not worth risking the
      page's content on.
    -->
    <script is:inline>
      (() => {
        const els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;

        document.documentElement.setAttribute('data-reveal-ready', '');

        // Honour the OS setting: show everything at once, observe nothing.
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach((el) => el.setAttribute('data-revealed', ''));
          return;
        }

        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.setAttribute('data-revealed', ''));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.setAttribute('data-revealed', '');
              io.unobserve(entry.target); // reveal once, never re-hide
            }
          },
          // Fire a little before the panel is fully on screen, so the motion
          // reads as the section arriving rather than as a delayed reaction.
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );

        els.forEach((el) => io.observe(el));

        // A jump-link lands the browser mid-section with no scroll event to
        // follow. IntersectionObserver reports on the next frame, but a hash
        // arriving on first load can beat observation being set up, so nudge
        // the target's panels directly.
        const revealHash = () => {
          const id = location.hash.slice(1);
          if (!id) return;
          const target = document.getElementById(id);
          if (!target) return;
          target.querySelectorAll('[data-reveal]').forEach((el) => {
            el.setAttribute('data-revealed', '');
            io.unobserve(el);
          });
        };
        revealHash();
        window.addEventListener('hashchange', revealHash);
      })();
    </script>
  </body>
</html>
