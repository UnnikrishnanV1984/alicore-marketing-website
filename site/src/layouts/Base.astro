---
import '../styles/global.css';
import { site } from '../content/site';
import { loadContact } from '../lib/settings';
import { defaultMeta, type Meta } from '../content/seo';

interface Props {
  meta?: Meta;
  /** Canonical path, e.g. "/gfrc". Defaults to the current URL's pathname. */
  path?: string;
  /** Adds JSON-LD beyond the sitewide Organization node. */
  jsonLd?: Record<string, unknown>[];
  bodyClass?: string;
}

const { meta = defaultMeta, path, jsonLd = [], bodyClass = '' } = Astro.props;

const contact = await loadContact(Astro.locals);
const canonicalPath = path ?? Astro.url.pathname;
const canonical = new URL(canonicalPath, site.url).href;

// A workers.dev deploy is staging and must stay out of the index, or it will
// compete with www.alicore.in for identical copy once that goes live. The
// meta tag, not robots.txt, is what actually de-indexes: a disallowed page can
// still be indexed from a link, and the crawler never sees the directive.
// robots.txt therefore permits crawling on staging so this tag is read.
const isStaging = /\.workers\.dev$/i.test(new URL(site.url).hostname);

// Sitewide Organization node. Deliberately carries no rating, certification or
// award properties -- none of that is verified. See the brand guidelines.
const organization: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Alicore',
  url: site.url,
  slogan: site.tagline,
  description:
    'Architectural products manufacturer specializing in GFRC and FRP panels, jalis, cornices, columns and custom architectural elements.',
  telephone: contact.phoneHref.replace('tel:', ''),
};
if (contact.email) organization.email = contact.email;

const graph = [organization, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    {isStaging && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alicore" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />

    <meta name="theme-color" content="#12110F" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!--
      Arm the scroll-reveal before first paint.

      Set from the end of <body> this arrived AFTER the panels had already
      painted, so applying opacity:0 animated them from visible to hidden and
      back: a visible flash on every load. It has to run in <head>.

      The failsafe matters as much as the flag. If the observer at the end of
      <body> never runs -- blocked, parse error, an engine without
      IntersectionObserver -- this attribute would leave every panel invisible
      for good. So arming it also schedules its own undo, cancelled the moment
      the observer takes over.
    -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.setAttribute('data-reveal-ready', '');
        window.setTimeout(() => {
          if (window.__alReveal) return;
          root.removeAttribute('data-reveal-ready');
        }, 3000);
      })();
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="al-skip-link" href="#main">Skip to content</a>
    <slot />

    <!--
      Scroll reveal for [data-reveal] elements.

      The hidden starting state lives behind [data-reveal-ready], armed in
      <head> and undone automatically if this script never claims it. So a
      failure here costs the animation, never the content.
    -->
    <script is:inline>
      (() => {
        const els = document.querySelectorAll('[data-reveal]');
        const revealAll = () => els.forEach((el) => el.setAttribute('data-revealed', ''));

        // Tell the head script's failsafe it is not needed.
        window.__alReveal = true;
        if (!els.length) return;

        try {
          // Honour the OS setting: show everything at once, observe nothing.
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return revealAll();
          if (!('IntersectionObserver' in window)) return revealAll();

          // Anything already on screen at load would otherwise finish
          // animating while the reader is still waiting for the page. On the
          // standalone pages, where a section sits right under a short page
          // hero, that made the effect invisible. Hold those briefly.
          const startedAt = performance.now();

          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                const el = entry.target;
                io.unobserve(el); // reveal once, never re-hide

                if (performance.now() - startedAt < 600) {
                  window.setTimeout(() => el.setAttribute('data-revealed', ''), 480);
                } else {
                  el.setAttribute('data-revealed', '');
                }
              }
            },
            // Fire a little before the element is fully on screen, so the
            // motion reads as the section arriving rather than a late reaction.
            { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
          );

          els.forEach((el) => io.observe(el));

          // A jump-link lands the browser mid-section with no scroll event to
          // follow, and a hash present on first load can beat observation
          // being set up, so nudge the target's own elements directly.
          const revealHash = () => {
            const id = location.hash.slice(1);
            if (!id) return;
            const target = document.getElementById(id);
            if (!target) return;
            target.querySelectorAll('[data-reveal]').forEach((el) => {
              el.setAttribute('data-revealed', '');
              io.unobserve(el);
            });
          };
          revealHash();
          window.addEventListener('hashchange', revealHash);
        } catch {
          // Show the content rather than leave it behind an animation that is
          // never going to run.
          revealAll();
        }
      })();
    </script>
  </body>
</html>
