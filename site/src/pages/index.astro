---
import Page from '../layouts/Page.astro';
import Hero from '../components/sections/Hero.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import ProductsSection from '../components/sections/ProductsSection.astro';
import MaterialSection from '../components/sections/MaterialSection.astro';
import WhySection from '../components/sections/WhySection.astro';
import CustomSection from '../components/sections/CustomSection.astro';
import ProjectsSection from '../components/sections/ProjectsSection.astro';
import ManufacturingSection from '../components/sections/ManufacturingSection.astro';
import IndustriesSection from '../components/sections/IndustriesSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';

import { loadSlotImages, loadSlotGalleries } from '../lib/media';
import { loadPublishedProjects } from '../lib/projects';
import { loadContact } from '../lib/settings';
import { gfrc, frp } from '../content/sections';
import { meta } from '../content/seo';

/**
 * The long-scroll home page -- every section from the mockup, in order.
 * Each section's CTA now deep-links to its standalone page as well as
 * supporting in-page anchors (plan section 3).
 */
const [slots, galleries, projects, contact] = await Promise.all([
  loadSlotImages(),
  loadSlotGalleries(),
  loadPublishedProjects(),
  loadContact(Astro.locals),
]);
---

<Page meta={meta['/']} path="/" scrollSpy active="/">
  <Hero images={galleries.get('alicore-hero') ?? []} />
  <AboutSection images={galleries.get('alicore-about') ?? []} capSlots={slots} />
  <ProductsSection slots={galleries} />

  <MaterialSection
    id="gfrc"
    eyebrow={gfrc.eyebrow}
    heading={gfrc.heading}
    intro={gfrc.intro}
    points={gfrc.points}
    cta={gfrc.cta}
    ctaHref="/gfrc"
    tone="warm-deep"
    slotId={gfrc.slot}
    placeholder="GFRC facade / jali screen close-up"
    image={slots.get(gfrc.slot)}
    ground="ink"
    media="left"
    ctaVariant="gold"
  />

  <!-- focus: this slot's upload is a 3-photo contact sheet; see SlotImage. -->
  <MaterialSection
    id="frp"
    eyebrow={frp.eyebrow}
    heading={frp.heading}
    intro={frp.intro}
    points={frp.points}
    cta={frp.cta}
    ctaHref="/frp"
    slotId={frp.slot}
    placeholder="FRP element / moulded component photo"
    image={slots.get(frp.slot)}
    focus="0% center"
    ground="ink2"
    media="right"
    ctaVariant="gold"
    tone="ink"
  />

  <WhySection image={slots.get('alicore-why')} />
  <CustomSection image={slots.get('alicore-custom')} />
  {contact.showProjects && <ProjectsSection projects={projects} />}
  <!-- Warm white with no outline. This photograph carries bright concrete and
       deep shadow in the same frame (backdrop p5 0.044, p95 0.939), so nothing
       clears the bar across all of it: white holds 3:1 over 70% of the copy,
       near-black over 52%. White is the better half. The real fix is an evenly
       lit photograph in this slot -- the outline that used to cover the gap is
       gone by the client's rule for this page. -->
  <ManufacturingSection
    tone="plain"
    images={galleries.get('alicore-factory') ?? []}
    journeyImage={slots.get('alicore-journey')}
  />
  <IndustriesSection />
  <ContactSection />
</Page>
