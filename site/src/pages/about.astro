---
import Page from '../layouts/Page.astro';
import PageHero from '../components/ui/PageHero.astro';
import MediaStage from '../components/ui/MediaStage.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import WhySection from '../components/sections/WhySection.astro';
import IndustriesSection from '../components/sections/IndustriesSection.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { loadSlotImages } from '../lib/media';
import { about } from '../content/sections';
import { capabilities } from '../content/site';
import { meta } from '../content/seo';

const slots = await loadSlotImages();
---

<Page meta={meta['/about']} path="/about" active="/about">
  <PageHero
    eyebrow="Who We Are"
    title="About ALICORE"
    lead="Built for architecture. Designed for possibility."
  />

  <!-- Same treatment as the home page's About section: the photograph is the
       stage and the introduction rises over it. The full body copy and the
       capability tiles follow below, where they have room to be read. -->
  <MediaStage
    slotId="alicore-about"
    placeholder="Close-up: GFRC surface texture / finished panel"
    image={slots.get('alicore-about')}
    align="left"
    ground="ink"
  >
    <Eyebrow label="Who We Are" ground="dark" />
    <p class="al-about-page__stagelead">{about.lead}</p>
  </MediaStage>

  <section class="al-section">
    <div class="al-container al-about-page">
      <div class="al-about-page__body">
        {about.body.map((p) => <p>{p}</p>)}
      </div>

      <aside class="al-about-page__aside">
        <div class="al-hairline-grid al-about-page__caps">
          {
            capabilities.map((c) => (
              <div class="al-cap">
                <div class="al-cap__k">{c.k}</div>
                <div class="al-cap__v">{c.v}</div>
              </div>
            ))
          }
        </div>
      </aside>
    </div>
  </section>

  <WhySection />
  <IndustriesSection />
  <CtaBand />
</Page>

<style>
  .al-about-page {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(40px, 6vw, 90px);
    align-items: start;
  }

  /* On the dark panel, not the page ground. */
  .al-about-page__stagelead {
    margin-top: 16px;
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.55;
    color: var(--color-on-dark);
    font-weight: 300;
  }

  /* Styles every paragraph, not just `p + p`. The lead used to be the first
     child, so a `p + p` rule was enough; now that the lead sits on the stage,
     the first body paragraph is the first child and would have gone unstyled. */
  .al-about-page__body p {
    font-size: 16px;
    line-height: 1.78;
    color: var(--color-on-light-60);
    max-width: 62ch;
  }

  .al-about-page__body p + p {
    margin-top: 20px;
  }

  .al-about-page__caps {
    grid-template-columns: 1fr;
    margin-top: 28px;
  }

  .al-cap {
    background: var(--color-bg);
    padding: 22px 24px;
  }

  .al-cap__k {
    font-family: var(--font-display);
    font-size: 16px;
  }

  .al-cap__v {
    font-size: 13px;
    color: var(--color-on-light-55);
    margin-top: 8px;
    line-height: 1.5;
  }
</style>
