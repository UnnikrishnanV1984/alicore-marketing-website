---
import Page from '../layouts/Page.astro';
import PageHero from '../components/ui/PageHero.astro';
import MediaStage from '../components/ui/MediaStage.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import SlotImage from '../components/ui/SlotImage.astro';
import WhySection from '../components/sections/WhySection.astro';
import IndustriesSection from '../components/sections/IndustriesSection.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { loadSlotGalleries, loadSlotImages } from '../lib/media';
import { about } from '../content/sections';
import { capabilities } from '../content/site';
import { meta } from '../content/seo';

const [galleries, capSlots] = await Promise.all([loadSlotGalleries(), loadSlotImages()]);
const aboutGallery = galleries.get('alicore-about') ?? [];
// Two panels, left then right. Looked up by position rather than array index:
// a gallery with only one of the two filled would otherwise shift the second
// panel into the first slot. Same ordering as the home page's About section.
const aboutAt = (position: number) => aboutGallery.find((i) => i.position === position);
const aboutOrdered = [aboutAt(2), aboutAt(1)];
---

<Page meta={meta['/about']} path="/about" active="/about">
  <PageHero
    eyebrow="Who We Are"
    title="About ALICORE"
    lead="Built for architecture. Designed for possibility."
  />

  <!-- Same treatment as the home page's About section: the photograph is the
       stage and the introduction rises over it. The full body copy and the
       capability tiles follow below, where they have room to be read. -->
  <MediaStage
    slotId="alicore-about"
    placeholder="Close-up: GFRC surface texture / finished panel"
    images={aboutOrdered}
    columns={2}
    align="left"
    ground="ink"
  >
    <Eyebrow label="Who We Are" ground="dark" />
    <p class="al-about-page__stagelead">{about.lead}</p>
  </MediaStage>

  <section class="al-section">
    <div class="al-container">
      <div class="al-about-page__body">
        {about.body.map((p) => <p>{p}</p>)}
      </div>

      <div class="al-hairline-grid al-about-page__caps">
        {
          capabilities.map((c) => (
            <div class="al-cap">
              <div class="al-cap__media">
                <SlotImage
                  slot={c.slot}
                  placeholder={c.shot}
                  image={capSlots.get(c.slot)}
                  ratio="4/3"
                  sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 25vw"
                />
              </div>
              <div class="al-cap__body">
                <div class="al-cap__k">{c.k}</div>
                <div class="al-cap__v">{c.v}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <WhySection image={capSlots.get('alicore-why')} />
  <IndustriesSection />
  <CtaBand />
</Page>

<style>
  /* On the dark panel, not the page ground. */
  .al-about-page__stagelead {
    margin-top: 16px;
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.55;
    color: var(--color-on-dark);
    font-weight: 300;
  }

  /* Styles every paragraph, not just `p + p`. The lead used to be the first
     child, so a `p + p` rule was enough; now that the lead sits on the stage,
     the first body paragraph is the first child and would have gone unstyled. */
  .al-about-page__body p {
    font-size: 16px;
    line-height: 1.78;
    color: var(--color-on-light-60);
    max-width: 62ch;
  }

  .al-about-page__body p + p {
    margin-top: 20px;
  }

  .al-about-page__caps {
    /* Same cell size as the Products grid's cards (ProductsSection.astro). */
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    margin-top: 52px;
  }

  .al-cap {
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
  }

  .al-cap__body {
    padding: 28px;
  }

  .al-cap__k {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 20px;
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }

  .al-cap__v {
    font-size: 13px;
    color: var(--color-on-light-55);
    margin-top: 8px;
    line-height: 1.5;
  }
</style>
