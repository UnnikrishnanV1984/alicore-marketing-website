---
import Admin from '../../layouts/Admin.astro';
import '../../styles/admin.css';
import MediaLibrary, { type AdminSlot } from '../../components/admin/MediaLibrary';
import { serviceClient, mediaUrl } from '../../lib/supabase';
import { slotPath, MAX_GALLERY_POSITIONS } from '../../lib/media';
import type { StaffUser } from '../../lib/auth';

export const prerender = false;

const staff = (Astro.locals as Record<string, unknown>).staff as StaffUser;

/** Only Products slots get a photograph gallery; everything else stays 1-up. */
const GALLERY_GROUP = 'Products';

/**
 * Slots that show more than one photograph side by side rather than a single
 * full-bleed image or a cycle. Value is how many positions to offer.
 */
const SPLIT_SLOTS: Record<string, number> = {
  'alicore-factory': 2,
  // The hero is a wall of three columns, one photograph each, left to right.
  // It used to cycle three frames per column and offered nine positions; the
  // cycle is gone, so positions 4-9 would have been uploads that never appear.
  'alicore-hero': 3,
};

/** Friendly names for a split slot's positions, where "Photo N" would be confusing. */
const SPLIT_LABELS: Record<string, Record<number, string>> = {
  'alicore-factory': { 1: 'Left photograph', 2: 'Right photograph' },
  'alicore-hero': { 1: 'Left column', 2: 'Middle column', 3: 'Right column' },
};

let slots: AdminSlot[] = [];
let loadError: string | null = null;

try {
  const supabase = serviceClient(Astro.locals);

  const [{ data: slotRows, error: slotErr }, { data: assetRows }, { data: projectRows }] =
    await Promise.all([
      supabase.from('media_slots').select('*').order('sort_order'),
      supabase.from('media_assets').select('slot_id, position, alt_text, variants').eq('is_active', true),
      supabase.from('projects').select('id, image_path, is_published').not('image_path', 'is', null),
    ]);

  if (slotErr) throw new Error(slotErr.message);

  type ActiveAsset = { alt: string; path: string };
  const active = new Map<string, Map<number, ActiveAsset>>();
  for (const a of assetRows ?? []) {
    if (!active.has(a.slot_id)) active.set(a.slot_id, new Map());
    const position = a.position ?? 1;
    // Follow the path the upload actually wrote. Deriving it would point at
    // the pre-versioning location, which a recent upload never touched.
    const stored = (a.variants as { webp?: Record<string, string> } | null)?.webp?.['640'];
    active.get(a.slot_id)!.set(position, {
      alt: a.alt_text ?? '',
      path: stored ?? slotPath(a.slot_id, 640, position),
    });
  }

  // One project per slot, per the seed data (supabase/migrations/0002_seed.sql)
  // -- the Projects group's "visible on site" toggle rides on this.
  const projectBySlot = new Map((projectRows ?? []).map((p) => [p.image_path as string, p]));

  slots = (slotRows ?? []).map((s) => {
    const maxPositions =
      s.group_title === GALLERY_GROUP ? MAX_GALLERY_POSITIONS : (SPLIT_SLOTS[s.id] ?? 1);
    const byPosition = active.get(s.id) ?? new Map<number, ActiveAsset>();

    const images = Array.from({ length: maxPositions }, (_, i) => {
      const position = i + 1;
      const asset = byPosition.get(position);
      const hasImage = asset !== undefined;
      return {
        position,
        hasImage,
        altText: asset?.alt ?? '',
        label: SPLIT_LABELS[s.id]?.[position],
        // Cache-bust the admin preview only; the public site relies on the
        // stable URL plus an edge purge.
        previewUrl: asset ? mediaUrl(asset.path, Astro.locals) : null,
      };
    });

    const project = projectBySlot.get(s.id);

    return {
      id: s.id,
      groupTitle: s.group_title,
      title: s.title,
      placeholder: s.placeholder,
      images,
      project: project ? { id: project.id, isPublished: project.is_published } : null,
    };
  });
} catch (err) {
  loadError = err instanceof Error ? err.message : 'Could not load the image library.';
}
---

<Admin title="Image Library" tab="media" staff={staff}>
  <div class="al-admin__eyebrow">Website Imagery</div>
  <h1 class="al-admin__h1">Image Library</h1>
  <p class="al-admin__intro">
    Every image placement on the website appears below. Drag a photograph onto a slot — or click to
    browse — and it fills that position on the live page. Use landscape shots at 2000px wide or
    larger; they are resized and converted automatically, so upload the best original you have.
    Each product carries up to {MAX_GALLERY_POSITIONS} photographs, which the live site cycles
    through automatically. The hero is a wall of nine — three columns of three, each column
    cycling on its own timer — and any frame left empty keeps the photograph the site ships with.
    Every other placement is a single photograph, except Manufacturing, which shows two side by
    side.
  </p>

  {
    loadError ? (
      <div class="al-admin-error" role="alert">
        {loadError}
      </div>
    ) : (
      <MediaLibrary client:load slots={slots} />
    )
  }
</Admin>
