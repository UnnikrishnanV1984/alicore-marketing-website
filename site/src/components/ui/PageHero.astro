---
import Eyebrow from './Eyebrow.astro';

/**
 * Compact masthead for interior pages. The home page has the full-bleed hero;
 * everything else opens with this so the h1 lands immediately without
 * duplicating the photographic treatment.
 */
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  breadcrumb?: { label: string; href: string }[];
}

const { eyebrow, title, lead, breadcrumb = [] } = Astro.props;
---

<section class="al-masthead" data-ground="dark">
  <div class="al-container">
    {
      breadcrumb.length > 0 && (
        <nav class="al-crumb" aria-label="Breadcrumb">
          <ol>
            <li>
              <a href="/">Home</a>
            </li>
            {breadcrumb.map((c) => (
              <li>
                <a href={c.href}>{c.label}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <Eyebrow label={eyebrow} ground="dark" />
    <h1 class="al-masthead__title al-balance">{title}</h1>
    {lead && <p class="al-masthead__lead">{lead}</p>}
  </div>
</section>

<style>
  .al-masthead {
    background: var(--color-ink);
    color: var(--color-on-dark);
    padding-block: clamp(56px, 8vw, 104px);
  }

  .al-crumb {
    margin-bottom: 26px;
  }

  .al-crumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-on-dark-42);
  }

  .al-crumb li + li::before {
    content: '/';
    margin-right: 10px;
    color: rgb(246 244 239 / 0.3);
  }

  .al-crumb a {
    color: var(--color-on-dark-42);
  }

  .al-crumb a:hover {
    color: var(--color-gold);
  }

  .al-masthead__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(34px, 5vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin-top: 20px;
    max-width: 20ch;
  }

  .al-masthead__lead {
    margin-top: 22px;
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.7;
    color: var(--color-on-dark-66);
    max-width: 58ch;
    font-weight: 300;
  }
</style>
