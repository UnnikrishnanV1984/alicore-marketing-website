---
import type { SlotImage } from '../../lib/media';
import { srcSet } from '../../lib/media';

/**
 * Renders an admin-managed image slot, or the art-direction placeholder when
 * no photograph has been uploaded yet.
 *
 * The placeholder is not a failure state -- with 18 empty slots at handover it
 * is what most of the site shows until the shoot happens (plan section 11). It
 * deliberately looks like a considered blank, matching the mockup's own
 * <image-slot> treatment, and it tells staff exactly which photo belongs here.
 */
interface Props {
  slot: string;
  /** Art-direction note from media_slots.placeholder. */
  placeholder: string;
  image?: SlotImage;
  /** CSS aspect-ratio, e.g. "4/3". Reserves space so CLS stays at 0. */
  ratio?: string;
  /** Above-the-fold images load eagerly and get fetchpriority=high. */
  priority?: boolean;
  sizes?: string;
  ground?: 'light' | 'dark';
  class?: string;
}

const {
  slot,
  placeholder,
  image,
  ratio = '4/3',
  priority = false,
  sizes = '(max-width: 768px) 100vw, 50vw',
  ground = 'light',
  class: className = '',
} = Astro.props;

const alt = image?.alt ?? '';
---

<div
  class={`al-slot al-slot--${ground} ${className}`}
  style={`--ratio:${ratio}`}
  data-slot={slot}
>
  {
    image ? (
      <img
        src={image.fallback}
        srcset={srcSet(image)}
        sizes={sizes}
        alt={alt}
        width={image.width ?? undefined}
        height={image.height ?? undefined}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
      />
    ) : (
      <div class="al-slot__empty">
        <span class="al-slot__mark" aria-hidden="true" />
        <span class="al-slot__note">{placeholder}</span>
      </div>
    )
  }
</div>

<style>
  .al-slot {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--color-panel-2);
  }

  .al-slot--dark {
    background: var(--color-ink-2);
  }

  .al-slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .al-slot__empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 24px;
    text-align: center;
  }

  .al-slot__mark {
    width: 8px;
    height: 8px;
    background: var(--color-gold-ink);
    flex: 0 0 auto;
  }

  .al-slot--dark .al-slot__mark {
    background: var(--color-gold);
  }

  .al-slot__note {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.7;
    max-width: 30ch;
    color: rgb(18 17 15 / 0.45);
  }

  .al-slot--dark .al-slot__note {
    color: rgb(246 244 239 / 0.42);
  }
</style>
