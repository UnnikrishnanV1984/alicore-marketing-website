---
import type { SlotImage } from '../../lib/media';
import { srcSet } from '../../lib/media';

/**
 * Renders an admin-managed image slot, or the art-direction placeholder when
 * no photograph has been uploaded yet.
 *
 * The placeholder is not a failure state -- with 18 empty slots at handover it
 * is what most of the site shows until the shoot happens (plan section 11). It
 * deliberately looks like a considered blank, matching the mockup's own
 * <image-slot> treatment, and it tells staff exactly which photo belongs here.
 */
interface Props {
  slot: string;
  /** Art-direction note from media_slots.placeholder. */
  placeholder: string;
  image?: SlotImage;
  /**
   * A slot's full photograph set (up to 5), ordered by position. When more
   * than one is present the slot cycles through them with a crossfade instead
   * of rendering a single static <img>. Takes precedence over `image` --
   * pass whichever one the caller loaded.
   */
  images?: SlotImage[];
  /** CSS aspect-ratio, e.g. "4/3". Reserves space so CLS stays at 0. */
  ratio?: string;
  /**
   * 'cover' (default) fills the box and crops. 'contain' shows the whole
   * photograph letterboxed against the slot's ground colour -- for a source
   * photo whose own aspect ratio doesn't suit the box (e.g. a square photo
   * in a 16:9 stage), rather than losing most of it to a crop.
   */
  fit?: 'cover' | 'contain';
  /**
   * Which part of the photograph to keep when `fit` is 'cover' and the box
   * is a different shape from the source -- any CSS object-position value.
   * Defaults to the centre, which is right for a photograph whose subject is
   * in the middle of it.
   *
   * Worth setting when the crop has to avoid part of the source rather than
   * merely frame it. The FRP stage is the case. That slot's upload is three
   * photographs butted together into one wide contact sheet -- a dark evening
   * mosque, a bright daylit pavilion, then another evening building -- and a
   * centred crop puts the join under the copy. Measured on the glyph pixels,
   * the backdrop is 0.11-0.21 luminance to x409 and 0.59-0.67 after it, so a
   * line of text starts on the dark photograph and finishes on the bright one.
   * White holds 3:1 across 83-94% of the first and 6-8% of the second; a warm
   * colour is the exact inverse, and nothing crosses the seam.
   *
   * focus="0% center" aims the crop at the left photograph alone: every line
   * lands on the dark one and the join goes off to the right where no text
   * sits. 99.5% of glyph edges clear 3:1 against 94.4% centred, and the worst
   * 1% sits at 3.13 rather than 1.86. Replace that upload with a single,
   * evenly bright photograph and the override can go -- the panel could then
   * take the warm tone About and GFRC use.
   */
  focus?: string;
  /** Above-the-fold images load eagerly and get fetchpriority=high. */
  priority?: boolean;
  sizes?: string;
  ground?: 'light' | 'dark';
  class?: string;
}

const {
  slot,
  placeholder,
  image,
  images,
  ratio = '4/3',
  fit = 'cover',
  focus = '50% 50%',
  priority = false,
  sizes = '(max-width: 768px) 100vw, 50vw',
  ground = 'light',
  class: className = '',
} = Astro.props;

const list = images && images.length > 0 ? images : image ? [image] : [];
const isGallery = list.length > 1;
/** Seconds each photograph holds before crossfading to the next. */
const HOLD_SECONDS = 4.5;
const duration = list.length * HOLD_SECONDS;
---

<div
  class={`al-slot al-slot--${ground} ${className}`}
  style={`--ratio:${ratio};--fit:${fit};--pos:${focus}`}
  data-slot={slot}
>
  {
    list.length === 0 ? (
      <div class="al-slot__empty">
        <span class="al-slot__mark" aria-hidden="true" />
        <span class="al-slot__note">{placeholder}</span>
      </div>
    ) : isGallery ? (
      <div
        class="al-slot__gallery"
        style={`--al-cycle-duration:${duration}s;--al-cycle-name:al-slot-cycle-${list.length}`}
      >
        {list.map((img, i) => (
          <img
            class="al-slot__cycle"
            style={`--al-cycle-delay:${i * HOLD_SECONDS}s`}
            src={img.fallback}
            srcset={srcSet(img)}
            sizes={sizes}
            alt={img.alt}
            width={img.width ?? undefined}
            height={img.height ?? undefined}
            loading={priority && i === 0 ? 'eager' : 'lazy'}
            decoding={priority && i === 0 ? 'sync' : 'async'}
            fetchpriority={priority && i === 0 ? 'high' : 'auto'}
          />
        ))}
      </div>
    ) : (
      <img
        src={list[0].fallback}
        srcset={srcSet(list[0])}
        sizes={sizes}
        alt={list[0].alt}
        width={list[0].width ?? undefined}
        height={list[0].height ?? undefined}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
      />
    )
  }
</div>

<style>
  .al-slot {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--color-panel-2);
  }

  .al-slot--dark {
    background: var(--color-ash-2);
  }

  .al-slot img {
    width: 100%;
    height: 100%;
    object-fit: var(--fit, cover);
    object-position: var(--pos, 50% 50%);
  }

  /* --- cycling gallery ---------------------------------------------------
     Pure-CSS crossfade: every photograph plays the same keyframe timeline,
     just staggered by its own position (--al-cycle-delay). The percentages
     below are fractions of the *whole* loop, so they hold regardless of how
     many photographs are in the set -- with N images the effective on-screen
     time per image is duration / N either way. */
  .al-slot__gallery {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .al-slot__cycle {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, 50% 50%);
    opacity: 0;
    animation-name: var(--al-cycle-name, al-slot-cycle-5);
    animation-duration: var(--al-cycle-duration, 20s);
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-delay: var(--al-cycle-delay, 0s);
  }

  /* One keyframe set per photograph count (2-5, the admin-enforced max).
     Each holds fully opaque for most of its 1/N share of the loop and fades
     at the edges, so pacing stays even whether a category has 2 photographs
     or 5 -- a single keyframe tuned for one N would race or stall for the
     others. */
  @keyframes al-slot-cycle-2 {
    0%, 100% { opacity: 0; }
    6% { opacity: 1; }
    44% { opacity: 1; }
    50% { opacity: 0; }
  }
  @keyframes al-slot-cycle-3 {
    0%, 100% { opacity: 0; }
    5% { opacity: 1; }
    28% { opacity: 1; }
    33% { opacity: 0; }
  }
  @keyframes al-slot-cycle-4 {
    0%, 100% { opacity: 0; }
    4% { opacity: 1; }
    21% { opacity: 1; }
    25% { opacity: 0; }
  }
  @keyframes al-slot-cycle-5 {
    0%, 100% { opacity: 0; }
    4% { opacity: 1; }
    16% { opacity: 1; }
    20% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .al-slot__cycle {
      animation: none;
      opacity: 0;
    }
    /* With motion disabled, hold the first photograph in the set still. */
    .al-slot__cycle:first-child {
      opacity: 1;
    }
  }

  .al-slot__empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 24px;
    text-align: center;
  }

  .al-slot__mark {
    width: 8px;
    height: 8px;
    background: var(--color-gold-ink);
    flex: 0 0 auto;
  }

  .al-slot--dark .al-slot__mark {
    background: var(--color-gold);
  }

  .al-slot__note {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.7;
    max-width: 30ch;
    color: rgb(18 17 15 / 0.45);
  }

  .al-slot--dark .al-slot__note {
    color: rgb(246 244 239 / 0.42);
  }
</style>
