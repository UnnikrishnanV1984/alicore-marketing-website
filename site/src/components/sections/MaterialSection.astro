---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import MediaStage from '../ui/MediaStage.astro';
import type { SlotImage as SlotImageType } from '../../lib/media';

/**
 * Shared by the GFRC and FRP sections. The photograph is the stage; the copy
 * rises over it as the section comes into view. GFRC puts the panel left,
 * FRP right, so the two read as a mirrored pair rather than a repeat.
 */
interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  intro: string;
  points: readonly string[];
  cta: string;
  ctaHref: string;
  slotId: string;
  placeholder: string;
  image?: SlotImageType;
  /** 'ink' = #12110F (GFRC), 'ink2' = #1A1917 (FRP) */
  ground?: 'ink' | 'ink2';
  /** Which side the copy panel sits on. */
  media?: 'left' | 'right';
  ctaVariant?: 'gold' | 'outline';
  headingLevel?: 'h1' | 'h2';
}

const {
  id,
  eyebrow,
  heading,
  intro,
  points,
  cta,
  ctaHref,
  slotId,
  placeholder,
  image,
  ground = 'ink',
  media = 'left',
  ctaVariant = 'gold',
  headingLevel = 'h2',
} = Astro.props;

const Heading = headingLevel;

// `media` names the side the photograph used to sit on. The photograph is now
// full width, so the panel takes the opposite side and the mirrored rhythm
// between GFRC and FRP survives the change.
const align = media === 'left' ? 'right' : 'left';
---

<section id={id} class="al-material-sec" data-ground="dark">
  <MediaStage
    slotId={slotId}
    placeholder={placeholder}
    image={image}
    align={align}
    ground={ground}
  >
    <Eyebrow label={eyebrow} ground="dark" />
    <Heading class="al-material-sec__title al-balance">{heading}</Heading>
    <p class="al-material-sec__intro">{intro}</p>

    <ul class="al-material-sec__points">
      {
        points.map((p) => (
          <li>
            <span class="al-material-sec__bullet" aria-hidden="true" />
            {p}
          </li>
        ))
      }
    </ul>

    <Button href={ctaHref} variant={ctaVariant} ground="dark" class="al-material-sec__cta">
      {cta}
    </Button>
  </MediaStage>
</section>

<style>
  .al-material-sec {
    background: var(--color-ink);
    color: var(--color-on-dark);
  }

  .al-material-sec__title {
    font-family: var(--font-display);
    font-weight: 400;
    /* Smaller than the two-column layout's clamp(28px, 3.4vw, 46px): the panel
       is a fixed 560px at most, so type that scaled with the viewport would
       wrap to five or six lines on a wide screen. */
    font-size: clamp(26px, 2.2vw, 34px);
    line-height: 1.14;
    margin-top: 16px;
    max-width: 20ch;
  }

  .al-material-sec__intro {
    margin-top: 16px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-on-dark-80);
    font-weight: 300;
  }

  /* Two columns inside the panel. Seven bullets stacked would make the panel
     taller than the photograph behind it. */
  .al-material-sec__points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 8px 24px;
    margin-top: 22px;
    list-style: none;
  }

  .al-material-sec__points li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 13.5px;
    color: var(--color-on-dark-80);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-rule-dark-soft);
  }

  .al-material-sec__bullet {
    width: 5px;
    height: 5px;
    background: var(--color-gold);
    flex: 0 0 auto;
  }

  .al-material-sec__cta {
    align-self: flex-start;
    margin-top: 24px;
  }

  @media (max-width: 480px) {
    .al-material-sec__cta {
      align-self: stretch;
    }
  }
</style>
