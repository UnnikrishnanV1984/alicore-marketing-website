---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import MediaStage from '../ui/MediaStage.astro';
import type { SlotImage as SlotImageType } from '../../lib/media';

/**
 * Shared by the GFRC and FRP sections. The photograph is the stage; the copy
 * rises over it as the section comes into view. GFRC puts the panel left,
 * FRP right, so the two read as a mirrored pair rather than a repeat.
 */
interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  intro: string;
  points: readonly string[];
  cta: string;
  ctaHref: string;
  slotId: string;
  placeholder: string;
  image?: SlotImageType;
  /** 'ink' = #12110F (GFRC), 'ink2' = #1A1917 (FRP) */
  ground?: 'ink' | 'ink2';
  /** Panel copy treatment -- see MediaStage. Decided by the photograph. */
  tone?: 'light' | 'warm' | 'warm-deep' | 'ink' | 'plain';
  /** Which part of the photograph the crop keeps -- see SlotImage. */
  focus?: string;
  /** Which side the copy panel sits on. */
  media?: 'left' | 'right';
  ctaVariant?: 'gold' | 'outline';
  headingLevel?: 'h1' | 'h2';
}

const {
  id,
  eyebrow,
  heading,
  intro,
  points,
  cta,
  ctaHref,
  slotId,
  placeholder,
  image,
  ground = 'ink',
  tone = 'light',
  focus,
  media = 'left',
  ctaVariant = 'gold',
  headingLevel = 'h2',
} = Astro.props;

const Heading = headingLevel;

// `media` names the side the photograph used to sit on. The photograph is now
// full width, so the panel takes the opposite side and the mirrored rhythm
// between GFRC and FRP survives the change.
const align = media === 'left' ? 'right' : 'left';
---

<section id={id} class="al-material-sec" data-ground="dark">
  <MediaStage
    slotId={slotId}
    placeholder={placeholder}
    image={image}
    align={align}
    ground={ground}
    tone={tone}
    focus={focus}
  >
    <Eyebrow label={eyebrow} ground="dark" />
    <Heading class="al-material-sec__title al-balance">{heading}</Heading>
    <p class="al-material-sec__intro">{intro}</p>

    <ul class="al-material-sec__points">
      {
        points.map((p) => (
          <li>
            <span class="al-material-sec__bullet" aria-hidden="true" />
            {p}
          </li>
        ))
      }
    </ul>

    <Button href={ctaHref} variant={ctaVariant} ground="dark" class="al-material-sec__cta">
      {cta}
    </Button>
  </MediaStage>
</section>

<style>
  .al-material-sec {
    background: var(--color-ash);
    color: var(--color-on-dark);
  }

  .al-material-sec__title {
    font-family: var(--font-display);
    font-weight: 500;
    /* Smaller than the two-column layout's clamp(28px, 3.4vw, 46px): the panel
       is a fixed 560px at most, so type that scaled with the viewport would
       wrap to five or six lines on a wide screen. */
    font-size: clamp(29px, 2.45vw, 38px);
    line-height: 1.14;
    margin-top: 16px;
    max-width: 20ch;
  }

  /* One set of numbers for every stage panel on the site -- 19px, 400, 1.78,
     the same as the Who We Are lead and the body copy those pages carry
     below the fold.

     600 was here to give a 1px glyph outline more stem to hold on to, on the
     theory that a heavier letter survives a bright picture better. Measured
     on the FRP panel it is the other way round: at 400 the outline covers a
     larger share of each glyph and the copy holds 3:1 across 94% of its area
     against 92% at 600. So the weight is not a per-tone decision after all.

     Colour is inherited, never set: the panel decides that from its tone, and
     a rule here would override it and put white back over a bright picture. */
  .al-material-sec__intro {
    margin-top: 16px;
    font-size: 19px;
    line-height: 1.78;
    color: inherit;
    font-weight: 400;
  }

  /* Two columns inside the panel. Seven bullets stacked would make the panel
     taller than the photograph behind it. */
  .al-material-sec__points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 8px 24px;
    margin-top: 22px;
    list-style: none;
  }

  .al-material-sec__points li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 16.5px;
    font-weight: 400;
    color: inherit;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-rule-dark-soft);
  }

  /* The hairline stays 12% white over a dark picture and flips to 34% black
     over a light one, where 12% white is nothing. */
  .al-photo-panel--warm .al-material-sec__points li,
  .al-photo-panel--warm-deep .al-material-sec__points li,
  .al-photo-panel--ink .al-material-sec__points li {
    border-bottom-color: var(--color-rule-photo);
  }

  .al-material-sec__bullet {
    width: 5px;
    height: 5px;
    background: var(--color-gold);
    flex: 0 0 auto;
  }

  /* Gold measures about 2:1 on these pictures. The bullet is 5px of pure
     decoration; let it take the copy's colour rather than vanish. */
  .al-photo-panel--warm .al-material-sec__bullet,
  .al-photo-panel--warm-deep .al-material-sec__bullet,
  .al-photo-panel--ink .al-material-sec__bullet {
    background: currentColor;
  }

  .al-material-sec__cta {
    align-self: flex-start;
    margin-top: 24px;
  }

  @media (max-width: 480px) {
    .al-material-sec__cta {
      align-self: stretch;
    }
  }
</style>
