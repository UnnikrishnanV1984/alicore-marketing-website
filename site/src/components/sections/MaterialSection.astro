---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import SlotImage from '../ui/SlotImage.astro';
import type { SlotImage as SlotImageType } from '../../lib/media';

/**
 * Shared by the GFRC and FRP sections. They are the same layout mirrored:
 * GFRC puts the photograph on the left, FRP on the right.
 */
interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  intro: string;
  points: readonly string[];
  cta: string;
  ctaHref: string;
  slotId: string;
  placeholder: string;
  image?: SlotImageType;
  /** 'ink' = #12110F (GFRC), 'ink2' = #1A1917 (FRP) */
  ground?: 'ink' | 'ink2';
  /** Which side the photograph sits on. */
  media?: 'left' | 'right';
  ctaVariant?: 'gold' | 'outline';
  headingLevel?: 'h1' | 'h2';
}

const {
  id,
  eyebrow,
  heading,
  intro,
  points,
  cta,
  ctaHref,
  slotId,
  placeholder,
  image,
  ground = 'ink',
  media = 'left',
  ctaVariant = 'gold',
  headingLevel = 'h2',
} = Astro.props;

const Heading = headingLevel;
---

<section id={id} class={`al-material-sec al-material-sec--${ground}`} data-ground="dark">
  <div class={`al-material-sec__grid al-material-sec__grid--${media}`}>
    <div class="al-material-sec__media">
      <SlotImage
        slot={slotId}
        placeholder={placeholder}
        image={image}
        ratio="1/1"
        ground="dark"
        sizes="(max-width: 800px) 100vw, 50vw"
        class="al-material-sec__slot"
      />
    </div>

    <div class="al-material-sec__body">
      <Eyebrow label={eyebrow} ground="dark" />
      <Heading class="al-material-sec__title al-balance">{heading}</Heading>
      <p class="al-material-sec__intro">{intro}</p>

      <ul class="al-material-sec__points">
        {
          points.map((p) => (
            <li>
              <span class="al-material-sec__bullet" aria-hidden="true" />
              {p}
            </li>
          ))
        }
      </ul>

      <Button href={ctaHref} variant={ctaVariant} ground="dark" class="al-material-sec__cta">
        {cta}
      </Button>
    </div>
  </div>
</section>

<style>
  .al-material-sec {
    color: var(--color-on-dark);
  }

  .al-material-sec--ink {
    background: var(--color-ink);
  }

  .al-material-sec--ink2 {
    background: var(--color-ink-2);
  }

  .al-material-sec__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
  }

  .al-material-sec__media {
    position: relative;
    min-height: clamp(320px, 42vw, 620px);
  }

  .al-material-sec__media :global(.al-slot) {
    height: 100%;
    aspect-ratio: auto;
  }

  /* Photograph right: reorder without changing DOM order, so the heading is
     still read first by a screen reader and on mobile. */
  .al-material-sec__grid--right .al-material-sec__media {
    order: 2;
  }

  @media (max-width: 800px) {
    .al-material-sec__grid--right .al-material-sec__media {
      order: 0;
    }
  }

  .al-material-sec__body {
    padding: clamp(56px, 7vw, 110px) clamp(24px, 5vw, 80px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .al-material-sec__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 3.4vw, 46px);
    line-height: 1.1;
    margin-top: 20px;
    max-width: 22ch;
  }

  .al-material-sec__intro {
    margin-top: 22px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-on-dark-66);
    max-width: 52ch;
    font-weight: 300;
  }

  .al-material-sec__points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 12px 28px;
    margin-top: 34px;
    list-style: none;
  }

  .al-material-sec__points li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    font-size: 14.5px;
    color: var(--color-on-dark-80);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-rule-dark-soft);
  }

  .al-material-sec__bullet {
    width: 5px;
    height: 5px;
    background: var(--color-gold);
    flex: 0 0 auto;
  }

  .al-material-sec__cta {
    align-self: flex-start;
    margin-top: 40px;
  }

  @media (max-width: 480px) {
    .al-material-sec__cta {
      align-self: stretch;
    }
  }
</style>
