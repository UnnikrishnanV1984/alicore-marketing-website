---
import Eyebrow from '../ui/Eyebrow.astro';
import EnquiryForm from '../forms/EnquiryForm';
import { loadContact } from '../../lib/settings';

interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const contact = await loadContact(Astro.locals);
const { hasEmail } = contact;

const directs = [
  { label: 'Call Us', value: contact.phoneDisplay, href: contact.phoneHref, wide: true, newTab: false },
  { label: 'WhatsApp Us', value: 'Send project details', href: contact.whatsappHref, wide: false, newTab: true },
  {
    label: 'Email Us',
    value: contact.emailDisplay,
    href: hasEmail ? contact.emailHref : '',
    wide: false,
    newTab: false,
  },
];
---

<section id="contact" class="al-contact" data-ground="dark">
  <!-- The scattered gold. Two layers of flecks that drift while the pointer is
       over the section and hold still the rest of the time. Decorative only. -->
  <div class="al-contact__sheen" aria-hidden="true"></div>

  <div class="al-container al-contact__grid">
    <div>
      <Eyebrow label="Contact" ground="ash" />
      <Heading class="al-contact__title al-balance">Let's Build Something <span class="al-contact__accent">Remarkable</span>.</Heading>
      <p class="al-contact__intro">
        Have an architectural requirement, drawing or project in development? Share your project
        details with our team and let's explore the right manufacturing solution.
      </p>

      <div class="al-hairline-grid al-contact__directs" data-ground="dark">
        {
          directs.map((d) =>
            d.href ? (
              <a
                href={d.href}
                class="al-direct"
                target={d.newTab ? '_blank' : undefined}
                rel={d.newTab ? 'noopener noreferrer' : undefined}
              >
                <span>
                  <span class="al-direct__label">{d.label}</span>
                  <span class={`al-direct__value${d.wide ? ' is-wide' : ''}`}>{d.value}</span>
                </span>
                <span class="al-direct__arrow" aria-hidden="true">→</span>
              </a>
            ) : (
              /* No verified address supplied yet -- shown, but not a dead mailto. */
              <div class="al-direct al-direct--pending">
                <span>
                  <span class="al-direct__label">{d.label}</span>
                  <span class="al-direct__value">{d.value}</span>
                </span>
              </div>
            ),
          )
        }
      </div>
    </div>

    <EnquiryForm
      client:visible
      turnstileSiteKey={turnstileSiteKey}
      whatsappHref={contact.whatsappHref}
      phoneHref={contact.phoneHref}
      phoneDisplay={contact.phoneDisplay}
    />
  </div>
</section>

<style>
  /* Golden green, from the reference the client supplied: a dark emerald
     field with a gold ribbon through it. The grey this replaces was
     --color-ash, the site's standard dark ground; the green is scoped to
     this section, so the masthead, materials, projects and footer keep it.

     The field is a diagonal two-stop green -- darkest at the corners, open
     in the middle, the way the reference lights its own -- with a low gold
     wash rising from the bottom left, under the copy rather than over it.
     The ribbon is the rule across the top edge: the one literal quotation
     from the reference, and 2px of it is enough to set the pairing. */
  .al-contact {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(
        140% 110% at 10% 100%,
        rgb(232 207 143 / 0.1) 0%,
        rgb(232 207 143 / 0) 46%
      ),
      linear-gradient(
        152deg,
        var(--color-green-deep) 0%,
        var(--color-green) 52%,
        var(--color-green-deep) 100%
      );
    color: var(--color-on-dark);
    padding-block: var(--spacing-section);
  }

  .al-contact::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      rgb(201 161 74 / 0) 0%,
      var(--color-green-gold) 20%,
      var(--color-green-gold-lit) 48%,
      var(--color-green-gold) 74%,
      rgb(201 161 74 / 0) 100%
    );
  }

  /* --- the scattered gold -------------------------------------------------
     Radial flecks rather than one wash, so the gold reads as scattered
     across the field the way it is in the client's reference. Two layers:
     this element and its ::before, drifting in opposite directions at
     different speeds, which is what stops the movement reading as the whole
     panel sliding.

     Both animations are PAUSED until the pointer is over the section. At
     rest the flecks are exactly where the stylesheet puts them, so a visitor
     who never hovers sees a still composition rather than something that
     moves on its own.

     The alphas are the ceiling, not a taste: at 0.16 the lightest fleck puts
     the ground under the intro copy at L 0.09, and the 10px gold labels are
     the first thing to fail there. Measured after the change, every block in
     the section still clears AA across 100% of its glyph pixels. */
  .al-contact__sheen {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(34% 30% at 14% 84%, rgb(232 207 143 / 0.16), transparent 62%),
      radial-gradient(20% 24% at 43% 46%, rgb(232 207 143 / 0.09), transparent 64%),
      radial-gradient(15% 19% at 27% 20%, rgb(232 207 143 / 0.08), transparent 60%);
    opacity: 0.8;
    transition: opacity 0.7s var(--ease-premium);
    animation: al-sheen-a 16s ease-in-out infinite alternate;
    animation-play-state: paused;
  }

  .al-contact__sheen::before {
    content: '';
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(24% 22% at 74% 18%, rgb(201 161 74 / 0.14), transparent 60%),
      radial-gradient(28% 26% at 88% 72%, rgb(201 161 74 / 0.11), transparent 62%),
      radial-gradient(16% 20% at 60% 88%, rgb(232 207 143 / 0.08), transparent 60%);
    animation: al-sheen-b 21s ease-in-out infinite alternate;
    animation-play-state: paused;
  }

  /* Two things happen on hover, because the drift alone is slow enough that
     a visitor would not connect it to their own pointer: the flecks come up
     to full strength at once, which is the acknowledgement, and then they
     start to move. */
  .al-contact:hover .al-contact__sheen {
    opacity: 1;
  }

  .al-contact:hover .al-contact__sheen,
  .al-contact:hover .al-contact__sheen::before {
    animation-play-state: running;
  }

  /* Small amounts. The flecks are soft-edged and low-alpha, so a few percent
     of travel is all it takes to read as movement; more looks like a sheet
     being dragged. */
  @keyframes al-sheen-a {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(6%, -4.5%, 0) scale(1.12);
    }
  }

  @keyframes al-sheen-b {
    from {
      transform: translate3d(0, 0, 0) scale(1.06);
    }
    to {
      transform: translate3d(-7%, 5%, 0) scale(1);
    }
  }

  /* The brightening stays -- it is a fade, not motion -- and the drift goes. */
  @media (prefers-reduced-motion: reduce) {
    .al-contact:hover .al-contact__sheen,
    .al-contact:hover .al-contact__sheen::before {
      animation-play-state: paused;
    }
  }

  /* Above the sheen. Without this the grid and the sheen are both in the
     section's own stacking context at z-index auto, and the form island --
     which paints late -- is the only part guaranteed to sit on top. */
  .al-contact__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: clamp(40px, 6vw, 90px);
    align-items: start;
  }

  /* Gold on the near-black contact ground: 6.96:1. */
  .al-contact__accent {
    color: var(--color-gold-on-ash);
  }

  .al-contact__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(32px, 4.4vw, 58px);
    line-height: 1.06;
    margin-top: 22px;
    max-width: 18ch;
  }

  .al-contact__intro {
    margin-top: 22px;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--color-on-dark-74);
    max-width: 48ch;
    font-weight: 300;
  }

  .al-contact__directs {
    margin-top: 40px;
  }

  .al-direct {
    background: var(--color-green-card);
    color: var(--color-on-dark);
    padding: 24px 26px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    transition: background-color 0.25s var(--ease-premium);
  }

  /* The hover goes DOWN rather than up, as it did on ash and for the same
     reason: --color-green-lift would put the 10px gold label at 4.49:1
     against its own ground. Going darker takes it to 7.5:1. */
  .al-direct:hover {
    background: var(--color-green-deep);
  }

  .al-direct--pending {
    opacity: 0.62;
  }

  .al-direct__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold-on-ash);
  }

  .al-direct__value {
    display: block;
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: 0.02em;
    margin-top: 8px;
  }

  .al-direct__value.is-wide {
    letter-spacing: 0.06em;
  }

  .al-direct__arrow {
    color: rgb(246 244 239 / 0.4);
  }
</style>

<!-- Form styles are global: EnquiryForm is a React island and Astro's scoped
     style hashing does not reach it. -->
<style is:global>
  .al-form {
    background: var(--color-bg);
    color: var(--color-ink);
    padding: clamp(28px, 4vw, 48px);
  }

  .al-form__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 15px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .al-form__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 18px 20px;
    margin-top: 28px;
  }

  .al-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .al-field--wide {
    margin-top: 22px;
  }

  .al-field__label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-on-light-55);
  }

  .al-field__label abbr {
    text-decoration: none;
    color: var(--color-gold-ink);
  }

  .al-field input,
  .al-field select,
  .al-field textarea {
    border: none;
    border-bottom: 1px solid rgb(18 17 15 / 0.25);
    background: none;
    padding: 10px 0;
    /* 16px minimum stops iOS zooming the viewport on focus. */
    font-size: 16px;
    outline: none;
    border-radius: 0;
    width: 100%;
  }

  .al-field textarea {
    resize: vertical;
  }

  .al-field input:focus,
  .al-field select:focus,
  .al-field textarea:focus {
    border-bottom-color: var(--color-gold-ink);
  }

  .al-field input[aria-invalid='true'] {
    border-bottom-color: #a8763a;
  }

  .al-field__err {
    font-size: 12.5px;
    color: #8c5a1e;
    line-height: 1.5;
  }

  /* Honeypot -- removed from the accessibility tree and off-screen, never
     display:none (some bots skip hidden fields). */
  .al-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .al-form__note {
    display: flex;
    align-items: center;
    gap: 14px;
    border: 1px solid rgb(18 17 15 / 0.16);
    background: rgb(18 17 15 / 0.03);
    padding: 18px 20px;
    margin-top: 26px;
    font-size: 13.5px;
    line-height: 1.6;
    color: rgb(18 17 15 / 0.65);
  }

  .al-form__note-mark {
    width: 6px;
    height: 6px;
    background: var(--color-gold);
    flex: 0 0 auto;
  }

  .al-form__note a {
    color: var(--color-gold-ink);
    border-bottom: 1px solid currentColor;
  }

  .al-form__turnstile {
    margin-top: 22px;
  }

  .al-form__error {
    margin-top: 22px;
    border-left: 2px solid #a8763a;
    padding: 4px 0 4px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13.5px;
    line-height: 1.6;
  }

  .al-form__error a {
    color: var(--color-gold-ink);
    border-bottom: 1px solid currentColor;
  }

  /* The one grey left inside the form card, and it sat under a green section
     looking like something nobody had got to. Same green as the field. */
  .al-form__submit {
    width: 100%;
    margin-top: 28px;
    background: var(--color-green);
    color: var(--color-bg);
    border: none;
    padding: 19px 26px;
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.25s var(--ease-premium);
  }

  .al-form__submit:hover:not(:disabled) {
    background: var(--color-gold-ink);
    color: var(--color-ink);
  }

  .al-form__submit:disabled {
    opacity: 0.55;
    cursor: progress;
  }

  .al-form__foot {
    font-size: 12.5px;
    color: rgb(18 17 15 / 0.5);
    margin-top: 14px;
    line-height: 1.6;
  }

  .al-form__foot a {
    color: var(--color-gold-ink);
  }

  /* --- success panel ---------------------------------------------------- */
  .al-form__done {
    padding: 60px 0;
    text-align: center;
  }

  .al-form__done-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold-ink);
  }

  .al-form__done-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 30px;
    margin-top: 18px;
  }

  .al-form__done-body {
    font-size: 15px;
    color: var(--color-on-light-60);
    margin-top: 14px;
    max-width: 36ch;
    margin-inline: auto;
    line-height: 1.65;
  }

  .al-form__ref {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-ink);
    margin-top: 18px;
  }

  .al-form__again {
    margin-top: 28px;
    border: 1px solid rgb(18 17 15 / 0.2);
    background: none;
    padding: 14px 26px;
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .al-form__again:hover {
    background: var(--color-green);
    color: var(--color-bg);
  }
</style>
