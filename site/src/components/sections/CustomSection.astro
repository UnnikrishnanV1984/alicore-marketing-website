---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import PhotoBackdrop from '../ui/PhotoBackdrop.astro';
import { steps } from '../../content/sections';
import { srcSet } from '../../lib/media';
import type { SlotImage as SlotImageType } from '../../lib/media';

/**
 * The backdrop is a wall of three columns, left to right, each cycling
 * through its own photographs.
 *
 * It was one wide landscape until the client swapped this section's backdrop
 * with the home hero's: the landscape went to the hero (see Hero.astro) and
 * the hero's three portraits came here. A portrait frame wants height, and
 * this section is tall -- heading, intro and two rows of cards -- so
 * full-height columns fit the sources better than they ever fit a hero. The
 * client then supplied eight photographs of custom architectural elements for
 * it, to be shown three at a time and kept moving.
 *
 * Eight into three columns is uneven, so they are dealt round-robin: the wall
 * shows entries 1, 2 and 3 of the list at t=0, and each column then advances
 * through every third one. That spreads consecutive photographs across the
 * width rather than stacking them in one column, and it means the two columns
 * holding three and the one holding two fall out of step with each other on
 * their own -- the loops are 19.5s and 13s. PhotoBackdrop staggers them a
 * little further so no two change at the same moment.
 *
 * Admin-managed through the `alicore-custom` slot. Uploads take over the whole
 * wall, dealt the same way, but only once there are at least as many as there
 * are columns -- fewer than that would leave a column empty, and a hole in a
 * row of three is exactly what shipping fallbacks is meant to prevent.
 */

const COLUMN_COUNT = 3;

/**
 * The shipped set, in the order the client listed them. `widths` is what each
 * source can actually produce without upscaling, which is not the same for
 * all of them: three arrived much smaller than the rest (see the note below),
 * so their srcset tops out early rather than inventing pixels.
 *
 * Sources are Custom Architectural Elements_N in the supplied folder; the
 * number here is that N, so a file can be traced back.
 *
 * NOTE ON RESOLUTION: 1 is 270x270, 3 is 375x500 and 4 is 564x564 square,
 * against 633-736px wide portraits for the rest. A column is about 480px wide
 * at 1440 and 640px at 1920, so 1 in particular is being asked to cover more
 * than twice its native width and will read soft next to its neighbours.
 * Larger copies of those three would fix it; nothing in code can.
 */
const SHIPPED = [
  { n: 6, widths: [440, 620] },
  { n: 7, widths: [440, 620] },
  { n: 8, widths: [440, 620] },
  { n: 1, widths: [270] },
  { n: 2, widths: [440, 620] },
  { n: 3, widths: [375] },
  { n: 4, widths: [440] },
  { n: 5, widths: [440, 620] },
] as const;

const shippedPath = (n: number, w: number) => `/custom/custom-${n}-${w}.webp`;

interface Props {
  headingLevel?: 'h1' | 'h2';
  /** The `alicore-custom` gallery. Fewer than COLUMN_COUNT keeps the shipped set. */
  images?: SlotImageType[];
}
const { headingLevel = 'h2', images = [] } = Astro.props;
const Heading = headingLevel;

type Shot = { src: string; srcset: string };

const uploaded: Shot[] = [...images]
  .sort((a, b) => a.position - b.position)
  .map((img) => ({ src: img.webp[1280] ?? img.fallback, srcset: srcSet(img) }));

const pool: Shot[] =
  uploaded.length >= COLUMN_COUNT
    ? uploaded
    : SHIPPED.map((s) => ({
        src: shippedPath(s.n, s.widths[s.widths.length - 1]),
        srcset: s.widths.map((w) => `${shippedPath(s.n, w)} ${w}w`).join(', '),
      }));

/** Deal round-robin: column c takes pool entries c, c+3, c+6, ... */
const frames = Array.from({ length: COLUMN_COUNT }, (_, c) => ({
  shots: pool.filter((_, i) => i % COLUMN_COUNT === c),
  focus: '50% center',
})).filter((col) => col.shots.length > 0);
---

<section id="custom" class="al-section al-custom al-custom--photo al-photo-sec">
  <PhotoBackdrop
    slot="alicore-custom"
    placeholder="Portrait photograph for the Custom Solutions wall"
    frames={frames}
    ground="light"
  />

  <div class="al-container al-photo-sec__inner">
    <div class="al-custom__head al-stagger" data-reveal>
      <div>
        <Eyebrow label="Custom Solutions" />
        <Heading class="al-custom__title">Your Design.<br />Our Manufacturing.</Heading>
      </div>
      <div>
        <p class="al-custom__intro">
          Every architectural project is different. Alicore works with architectural drawings, CAD
          files, reference images and design concepts to develop customized architectural products
          according to project requirements.
        </p>
        <Button href="/contact" variant="gold" class="al-custom__cta">Discuss Your Project</Button>
      </div>
    </div>

    <ol class="al-custom__steps al-stagger" data-reveal>
      {
        steps.map((s) => (
          <li class="al-step">
            <div class="al-step__n">{s.n}</div>
            <h3 class="al-step__name">{s.name}</h3>
            <p class="al-step__desc">{s.desc}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* The wall behind this section always renders -- every column has a shipped
     file behind it -- so .al-custom--photo is always on and the flat panel
     ground below never shows. Both are kept: they are what the section falls
     back to if the backdrop is ever removed again. */
  .al-custom {
    background: var(--color-panel);
  }

  .al-custom--photo {
    background: none;
  }

  .al-custom__head {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: clamp(32px, 5vw, 80px);
    align-items: end;
  }

  .al-custom__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(30px, 3.8vw, 50px);
    line-height: 1.08;
    margin-top: 20px;
  }

  .al-custom__intro {
    font-size: 16px;
    line-height: 1.75;
    color: rgb(18 17 15 / 0.65);
    max-width: 54ch;
  }

  .al-custom__cta {
    margin-top: 26px;
  }

  .al-custom__steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1px;
    background: var(--color-rule);
    margin-top: 60px;
    border-top: 1px solid var(--color-rule);
    list-style: none;
  }

  /* Three across, so the six steps fill two complete rows. auto-fit resolves
     to four columns on a desktop and leaves two empty cells -- invisible
     against a flat ground, two holes once a photograph shows through them. */
  @media (min-width: 1000px) {
    .al-custom__steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* The flat-ground case, when no photograph has been uploaded for the slot. */
  .al-step {
    padding: 34px 30px 40px;
    background: var(--color-panel);
    border-bottom: 1px solid var(--color-rule);
  }

  .al-step__n {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 300;
    color: var(--color-gold);
    line-height: 1;
  }

  .al-step__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 22px;
  }

  .al-step__desc {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--color-on-light-60);
    margin-top: 12px;
  }

  /* --- over a photograph -------------------------------------------------
     The cards carry no ground: the photograph runs straight through them.
     They used to wear a 0.26 cream wash (.al-glass), which is what made the
     six steps read as tiles rather than as copy laid on the picture.

     The grid needs care when they go transparent. .al-custom__steps draws its
     hairlines the way .al-hairline-grid does -- fill the container, let 1px
     gaps show between opaque cells -- so with nothing in the cells that fill
     becomes a tinted rectangle behind all six, a ground by the back door.
     Same trap the Why section hit. The container carries no fill here and each
     card draws its own hairline, meeting its neighbour's in the gap. */
  .al-custom--photo .al-step {
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    border-bottom: 0;
    box-shadow: 0 0 0 1px rgb(18 17 15 / 0.22);
  }

  .al-custom--photo .al-custom__steps {
    background: transparent;
    border-top-color: rgb(18 17 15 / 0.22);
  }

  /* -60 measures 4.79:1 even on a solid ground; over a photograph it drops
     under AA, so the body copy goes up a step. */
  .al-custom--photo .al-step__desc {
    color: var(--color-on-light-72);
  }

  /* 40px, so large text: 3:1. --color-gold-warm measures 1.7-2.4:1 against the
     pale stone in this photograph, so the number takes the deep gold.

     Re-measured with the wash gone, on the six cards' own glyph pixels: the
     deep gold holds 3:1 across 91.9% of them (median 4.25:1). The black copy
     beside it is unaffected -- 99.3% at 3:1 and 97.3% at 4.5:1 -- because this
     photograph is bright almost everywhere the cards sit. */
  .al-custom--photo .al-step__n {
    color: var(--color-gold-deep);
  }
</style>
