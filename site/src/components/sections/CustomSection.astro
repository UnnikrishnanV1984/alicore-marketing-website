---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import { steps } from '../../content/sections';

interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<section id="custom" class="al-section al-custom">
  <div class="al-container">
    <div class="al-custom__head">
      <div>
        <Eyebrow label="Custom Solutions" />
        <Heading class="al-custom__title">Your Design. Our Manufacturing.</Heading>
      </div>
      <div>
        <p class="al-custom__intro">
          Every architectural project is different. Alicore works with architectural drawings, CAD
          files, reference images and design concepts to develop customized architectural products
          according to project requirements.
        </p>
        <Button href="/contact" variant="ink" class="al-custom__cta">Discuss Your Project</Button>
      </div>
    </div>

    <ol class="al-custom__steps">
      {
        steps.map((s) => (
          <li class="al-step">
            <div class="al-step__n">{s.n}</div>
            <h3 class="al-step__name">{s.name}</h3>
            <p class="al-step__desc">{s.desc}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .al-custom {
    background: var(--color-panel);
  }

  .al-custom__head {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: clamp(32px, 5vw, 80px);
    align-items: end;
  }

  .al-custom__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(30px, 3.8vw, 50px);
    line-height: 1.08;
    margin-top: 20px;
  }

  .al-custom__intro {
    font-size: 16px;
    line-height: 1.75;
    color: rgb(18 17 15 / 0.65);
    max-width: 54ch;
  }

  .al-custom__cta {
    margin-top: 26px;
  }

  .al-custom__steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1px;
    background: var(--color-rule);
    margin-top: 60px;
    border-top: 1px solid var(--color-rule);
    list-style: none;
  }

  .al-step {
    background: var(--color-panel);
    padding: 34px 30px 40px;
    border-bottom: 1px solid var(--color-rule);
  }

  .al-step__n {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 300;
    color: var(--color-gold);
    line-height: 1;
  }

  .al-step__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 22px;
  }

  .al-step__desc {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--color-on-light-60);
    margin-top: 12px;
  }
</style>
