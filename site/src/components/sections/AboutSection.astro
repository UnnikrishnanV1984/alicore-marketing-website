---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import MediaStage from '../ui/MediaStage.astro';
import SlotImage from '../ui/SlotImage.astro';
import { capabilities } from '../../content/site';
import { about } from '../../content/sections';
import type { SlotImage as SlotImageType } from '../../lib/media';

interface Props {
  /**
   * The alicore-about gallery. The stage shows ONE photograph now, at
   * position 1; it used to pair two side by side. Still a gallery rather than
   * a single slot so the admin keeps one tile per placement, and still looked
   * up by position rather than array index -- an empty gallery must give
   * nothing back, not the first thing that happens to be in the array.
   *
   * It crops to fill (object-fit: cover): the stage is full-bleed and its box
   * shape varies with viewport width, so no fixed photo aspect ratio fills it
   * edge to edge on every screen without cropping.
   *
   * The copy sits on the RIGHT, in warm white, and both follow from the
   * photograph rather than from taste. This one looks up a gold ribbed facade
   * into blue sky: bright gold across the left two thirds, a deep curved form
   * down the right. Measured on the copy's own glyph pixels, the left-hand
   * placement it used to have gave no colour a good answer -- the best was
   * near-black at 81% of them over 3:1, and the deep brown it shipped with
   * 78%. On the right the backdrop is dark and even (median luminance 0.03
   * against 0.43), and warm white holds 3:1 across 95.4% and AA across 88.2%.
   *
   * A different photograph in this slot may well want the left side and a
   * dark tone again. Re-measure rather than assume.
   */
  images: SlotImageType[];
  /** One photograph per capability tile, keyed by `capabilities[].slot`. */
  capSlots?: Map<string, SlotImageType>;
  /** h2 on the home page; the /about page supplies its own h1. */
  headingLevel?: 'h1' | 'h2';
  showCta?: boolean;
}

const { images, capSlots = new Map(), headingLevel = 'h2', showCta = true } = Astro.props;
const Heading = headingLevel;
const at = (position: number) => images.find((i) => i.position === position);
---

<section id="about">
  <!-- The photograph carries the section; the introduction rises over it.
       The capability tiles stay below in their own band -- four of them inside
       the panel would make it taller than the image it sits on. -->
  <MediaStage
    slotId="alicore-about"
    placeholder="Close-up: GFRC surface texture / finished panel"
    image={at(1)}
    fill
    tone="plain"
    align="right"
    ground="ink"
  >
    <Eyebrow label="Who We Are" ground="dark" />
    <Heading class="al-about__title al-balance">
      Built for Architecture. Designed for Possibility.
    </Heading>
    <p class="al-about__lead">{about.lead}</p>
    {showCta && <Button href="/about" variant="outline" ground="dark" size="sm" class="al-about__cta">Discover Alicore</Button>}
  </MediaStage>

  <div class="al-section al-about__below">
    <div class="al-container">
      {about.body.slice(0, 2).map((p) => <p class="al-about__body">{p}</p>)}

      <div class="al-hairline-grid al-about__caps">
        {
          capabilities.map((c) => (
            <div class="al-cap">
              <div class="al-cap__media">
                <SlotImage
                  slot={c.slot}
                  placeholder={c.shot}
                  image={capSlots.get(c.slot)}
                  ratio="4/3"
                  sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 25vw"
                />
              </div>
              <div class="al-cap__body">
                <div class="al-cap__k">{c.k}</div>
                <div class="al-cap__v">{c.v}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Heavier and a size up: nothing sits behind this copy now. */
  .al-about__title {
    font-family: var(--font-display);
    font-weight: 500;
    /* Smaller than the old two-column clamp(30px, 3.8vw, 50px): the panel is
       at most 560px wide, so viewport-scaled type wrapped to five lines. */
    font-size: clamp(29px, 2.6vw, 40px);
    line-height: 1.12;
    letter-spacing: -0.01em;
    margin-top: 16px;
    max-width: 20ch;
  }

  /* 400 and 1.78, matching .al-about__body below it. The 600 was there to
     give a 1px glyph outline more stem to hold on to; the outline-free tones
     have none, so it is not needed.

     Inherited, not set: a colour of its own here would override the tone and
     put white back over the sky. */
  .al-about__lead {
    margin-top: 16px;
    font-size: 19px;
    line-height: 1.78;
    color: inherit;
    font-weight: 400;
  }

  .al-about__cta {
    margin-top: 26px;
  }

  .al-about__below {
    background: var(--color-panel);
  }

  .al-about__body {
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-on-light-60);
    max-width: 68ch;
  }

  .al-about__body + .al-about__body {
    margin-top: 18px;
  }

  .al-about__caps {
    /* Same cell size as the Products grid's cards (ProductsSection.astro). */
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    margin-top: 44px;
  }

  .al-cap {
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
  }

  .al-cap__body {
    padding: 28px;
  }

  .al-cap__k {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 20px;
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }

  .al-cap__v {
    font-size: 13px;
    color: var(--color-on-light-55);
    margin-top: 8px;
    line-height: 1.5;
  }
</style>
