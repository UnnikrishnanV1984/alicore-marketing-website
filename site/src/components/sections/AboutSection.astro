---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import MediaStage from '../ui/MediaStage.astro';
import SlotImage from '../ui/SlotImage.astro';
import { capabilities } from '../../content/site';
import { about } from '../../content/sections';
import type { SlotImage as SlotImageType } from '../../lib/media';

interface Props {
  /**
   * The alicore-about gallery: position 1 is the right panel, position 2 the
   * left. Looked up BY POSITION rather than by array index, because a gallery
   * with a gap in it -- one panel filled, the other not -- shifts every later
   * index down by one and would silently swap the panels.
   *
   * Both panels crop to fill (object-fit: cover): the stage is full-bleed and
   * its box shape varies with viewport width, so no fixed photo aspect ratio
   * fills it edge to edge on every screen without cropping.
   */
  images: SlotImageType[];
  /** One photograph per capability tile, keyed by `capabilities[].slot`. */
  capSlots?: Map<string, SlotImageType>;
  /** h2 on the home page; the /about page supplies its own h1. */
  headingLevel?: 'h1' | 'h2';
  showCta?: boolean;
}

const { images, capSlots = new Map(), headingLevel = 'h2', showCta = true } = Astro.props;
const Heading = headingLevel;
const at = (position: number) => images.find((i) => i.position === position);
const ordered = [at(2), at(1)];
---

<section id="about">
  <!-- The photograph carries the section; the introduction rises over it.
       The capability tiles stay below in their own band -- four of them inside
       the panel would make it taller than the image it sits on. -->
  <MediaStage
    slotId="alicore-about"
    placeholder="Close-up: GFRC surface texture / finished panel"
    images={ordered}
    columns={2}
    align="left"
    ground="ink"
  >
    <Eyebrow label="Who We Are" ground="dark" />
    <Heading class="al-about__title al-balance">
      Built for Architecture. Designed for Possibility.
    </Heading>
    <p class="al-about__lead">{about.lead}</p>
    {showCta && <Button href="/about" variant="outline" ground="dark" size="sm" class="al-about__cta">Discover Alicore</Button>}
  </MediaStage>

  <div class="al-section al-about__below">
    <div class="al-container">
      {about.body.slice(0, 2).map((p) => <p class="al-about__body">{p}</p>)}

      <div class="al-hairline-grid al-about__caps">
        {
          capabilities.map((c) => (
            <div class="al-cap">
              <div class="al-cap__media">
                <SlotImage
                  slot={c.slot}
                  placeholder={c.shot}
                  image={capSlots.get(c.slot)}
                  ratio="4/3"
                  sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 25vw"
                />
              </div>
              <div class="al-cap__body">
                <div class="al-cap__k">{c.k}</div>
                <div class="al-cap__v">{c.v}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .al-about__title {
    font-family: var(--font-display);
    font-weight: 400;
    /* Smaller than the old two-column clamp(30px, 3.8vw, 50px): the panel is
       at most 560px wide, so viewport-scaled type wrapped to five lines. */
    font-size: clamp(26px, 2.3vw, 36px);
    line-height: 1.12;
    letter-spacing: -0.01em;
    margin-top: 16px;
    max-width: 20ch;
  }

  .al-about__lead {
    margin-top: 16px;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--color-on-dark-80);
    font-weight: 300;
  }

  .al-about__cta {
    margin-top: 26px;
  }

  .al-about__below {
    background: var(--color-panel);
  }

  .al-about__body {
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-on-light-60);
    max-width: 68ch;
  }

  .al-about__body + .al-about__body {
    margin-top: 18px;
  }

  .al-about__caps {
    /* Same cell size as the Products grid's cards (ProductsSection.astro). */
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    margin-top: 44px;
  }

  .al-cap {
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
  }

  .al-cap__body {
    padding: 28px;
  }

  .al-cap__k {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 20px;
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }

  .al-cap__v {
    font-size: 13px;
    color: var(--color-on-light-55);
    margin-top: 8px;
    line-height: 1.5;
  }
</style>
