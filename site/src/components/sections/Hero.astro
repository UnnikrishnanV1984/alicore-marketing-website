---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import { pillars } from '../../content/site';
import { srcSet } from '../../lib/media';
import type { SlotImage as SlotImageType } from '../../lib/media';

/**
 * The photographs fill the hero and the copy arrives over them.
 *
 * Three full-height COLUMNS rather than one landscape image, because a
 * full-height column is a portrait frame -- and the supplied photography is
 * portrait. At 1366px each column is roughly 455x700 (ratio 0.65) against
 * sources of 668x1000 (0.67), so they land almost exactly, with no upscaling
 * at 1x. One landscape image would have needed 2.6x upscaling and would have
 * cropped away 60% of every frame.
 *
 * One photograph per column, shown at all times. The hero used to cycle three
 * frames per column on staggered timers; that is gone at the client's request,
 * because copy over a backdrop that keeps changing has to stay legible against
 * all nine photographs at once and could not.
 *
 * The three are admin-managed through the `alicore-hero` slot, position 1 to 3
 * left to right. Any position left empty falls back to the photograph shipped
 * in public/hero/, so the wall is never broken by a slot nobody has filled and
 * the site looks right on a first deploy.
 */

/* `focus` is object-position for the cover crop. Column one carries the copy
   and has a deep recessed window in it; aiming its crop right keeps more of
   that shadow out from behind the type, which is worth 3 points of contrast
   (86.8% of glyph pixels at 3:1 against 83.9% centred) and costs nothing.
   Column two measured the same either way, so it stays centred. */
const COLUMNS = [
  { id: 'home-1', alt: 'Stone-clad contemporary facade with a folded entrance reveal', focus: '100% center' },
  { id: 'home-2', alt: 'Limestone and timber facade with vertical fin screening', focus: '50% center' },
  { id: 'home-3', alt: 'Banded stone facade with a recessed timber entrance', focus: '50% center' },
] as const;

/** 440 and 620 are the two derivatives in public/hero -- the widest the
    supplied files reach without upscaling (the smallest source is 633px). */
const src = (id: string, w: number) => `/hero/${id}-${w}.webp`;

interface Props {
  /** The `alicore-hero` gallery. Missing positions keep the shipped files. */
  images?: SlotImageType[];
}
const { images = [] } = Astro.props;

/**
 * Either the uploaded photograph for a column or the file shipped with the
 * repo. Both carry a srcset, so the two cases differ only in the URLs.
 */
function columnSources(ci: number) {
  const uploaded = images.find((i) => i.position === ci + 1);
  if (uploaded) return { src: uploaded.webp[1280] ?? uploaded.fallback, srcset: srcSet(uploaded) };
  const { id } = COLUMNS[ci];
  return { src: src(id, 620), srcset: `${src(id, 440)} 440w, ${src(id, 620)} 620w` };
}
---

<section id="top" class="al-hero" data-ground="dark">
  <div class="al-hero__stage" aria-hidden="true">
    {
      COLUMNS.map((col, ci) => {
        const f = columnSources(ci);
        return (
          <div class="al-hero__col">
            <img
              class="al-hero__frame"
              style={`object-position:${col.focus}`}
              src={f.src}
              srcset={f.srcset}
              sizes="33vw"
              alt=""
              width="620"
              height="928"
              loading="eager"
              decoding="async"
              fetchpriority={ci === 0 ? 'high' : 'auto'}
            />
          </div>
        );
      })
    }
  </div>

  <!-- The photographs are decorative: they carry no information the copy does
       not, and alt text on a rotating backdrop would be read aloud repeatedly.
       The stage is aria-hidden and this description is what a screen reader
       gets instead. -->
  <p class="sr-only">
    Background: three photographs of contemporary stone and timber facades.
  </p>

  <div class="al-container al-hero__inner">
    <div class="al-hero__copy al-photo-panel al-photo-panel--ink" data-hero-copy>
      <Eyebrow label="Architectural Products Manufacturer" ground="dark" />
      <h1 class="al-hero__title al-balance">
        Architectural Products. Engineered to <span class="al-hero__accent">Elevate</span>.
      </h1>
      <p class="al-hero__lead">
        Premium GFRC and FRP architectural solutions for contemporary buildings, facades and
        interiors.
      </p>
      <p class="al-hero__support">
        Alicore combines architectural design, engineering and advanced manufacturing to create
        durable, lightweight and highly customizable architectural elements for residential,
        commercial, hospitality and large-scale developments.
      </p>
      <div class="al-hero__cta">
        <Button href="/products" variant="gold">Explore Products</Button>
        <Button href="/contact" variant="outline" ground="dark">Request a Quote</Button>
      </div>
    </div>
  </div>

  <div class="al-hero__pillars">
    <div class="al-container al-hero__pillars-grid">
      {
        pillars.map((p) => (
          <div class="al-pillar">
            <span class="al-pillar__n">{p.n}</span>
            <span class="al-pillar__code">{p.code}</span>
            <span class="al-pillar__full">{p.full}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // The hero no longer cycles: every column shows one photograph, always.
  // All that is left is revealing the copy once the page is ready.
  (() => {
    const copy = document.querySelector<HTMLElement>('[data-hero-copy]');
    if (!copy) return;
    // Reveal on the next frame so the transition has a start state to animate
    // from; setting it in the same frame as the class would jump.
    requestAnimationFrame(() => requestAnimationFrame(() => copy.setAttribute('data-in', '')));
  })();
</script>

<style>
  /* Two rows: the photographs and the copy share the first, stacked in one
     grid cell; the pillar strip gets the second, below the pictures.

     It used to sit on top of them behind a 0.62 band. With no band and no
     glyph outline the four labels held 3:1 across 59% of their pixels -- a
     word like PRECAST lands on dark planting and disappears. Putting the strip
     under the photographs rather than over them fixes that without veiling
     anything: the pictures end where it begins instead of being covered. */
  .al-hero {
    position: relative;
    background: var(--color-ash);
    color: var(--color-on-dark);
    min-height: min(880px, 92vh);
    display: grid;
    /* minmax(0, 1fr), not 1fr. A grid item's automatic minimum size is its
       min-content width, so an `auto`/`1fr` column is free to grow past the
       viewport to fit its contents -- and the pillar strip's
       repeat(auto-fit, minmax(210px, 1fr)) reports a min-content of four full
       columns when it is measured against an indefinite width. That made every
       row 952px wide inside a 390px phone (4x210 + 3x24 gap + 40 padding), and
       overflow:hidden below cropped the hero copy rather than wrapping it.
       This was a flex column before and the bug could not arise: a column flex
       container stretches its items to its own width, so nothing was ever
       sized by content. Pinning the minimum to 0 restores that. */
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    overflow: hidden;
    isolation: isolate;
  }

  /* --- the wall of photographs ------------------------------------------ */
  .al-hero__stage {
    grid-area: 1 / 1;
    z-index: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--color-ash-2);
  }

  .al-hero__col {
    position: relative;
    overflow: hidden;
  }

  .al-hero__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- the copy --------------------------------------------------------- */
  .al-hero__inner {
    grid-area: 1 / 1;
    align-self: end;
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: clamp(56px, 8vh, 110px) clamp(40px, 6vw, 72px);
  }

  /* NO ground behind the copy -- no panel, no scrim, no tint. The photographs
     are the point of this section and anything laid behind the type hides part
     of them. That is a rule for the whole site, not a choice made here.

     Which means the copy has to carry itself on colour and outline alone. See
     .al-hero__copy below the fold for how, and global.css for the widths. */
  .al-hero__copy {
    max-width: 640px;
    padding: clamp(26px, 3vw, 40px) clamp(22px, 2.6vw, 36px);
  }

  /* Each element rises in turn once the page is ready. Scoped to [data-in],
     which the script sets -- so if the script never runs the copy is simply
     visible, never stuck at opacity 0. */
  .al-hero__copy > :global(*) {
    opacity: 1;
  }

  .al-hero__copy[data-in] > :global(*) {
    animation: al-hero-rise 1.1s var(--ease-premium) both;
  }

  .al-hero__copy[data-in] > :global(:nth-child(1)) { animation-delay: 0.15s; }
  .al-hero__copy[data-in] > :global(:nth-child(2)) { animation-delay: 0.32s; }
  .al-hero__copy[data-in] > :global(:nth-child(3)) { animation-delay: 0.49s; }
  .al-hero__copy[data-in] > :global(:nth-child(4)) { animation-delay: 0.66s; }
  .al-hero__copy[data-in] > :global(:nth-child(5)) { animation-delay: 0.83s; }

  @keyframes al-hero-rise {
    from {
      opacity: 0;
      transform: translateY(34px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .al-hero__title {
    font-family: var(--font-display);
    /* Up from 400. With no panel behind it the stroke has to hold its own
       against a facade that can be any tone. */
    font-weight: 500;
    font-size: clamp(40px, 6.6vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.015em;
    margin-top: 26px;
    max-width: 17ch;
  }

  /* The same gold as the Explore Products button's fill, at the client's
     request -- one gold in the hero rather than two.

     It is the weaker choice on contrast and worth recording why. --color-gold
     is very nearly the tone of pale limestone, so over these photographs it
     measures far below what gold-deep managed. The word is 88px display type,
     which owes 3:1 rather than 4.5:1, and it is one word of five in a heading
     whose other four carry the meaning -- but it is under that bar on the
     lighter stretches of the picture. See the numbers in the commit. */
  .al-hero__accent {
    color: var(--color-gold);
  }

  /* font-weight was declared twice here, 600 and then 300, so the lead had
     been rendering light the whole time -- visibly fainter than the support
     paragraph directly beneath it. One declaration now, at 400: the 600 was
     there to give the glyph outline more stem to hold, and the outline is
     gone. Same weight as every stage panel lead on the site. */
  .al-hero__lead {
    margin-top: 26px;
    max-width: 52ch;
    font-size: clamp(21px, 2vw, 25px);
    line-height: 1.58;
    color: inherit;
    font-weight: 400;
  }

  /* Was --color-ink: black copy inside a panel whose other text is white,
     which only worked while the blur guaranteed a light ground behind it.
     With the picture bare it joins the rest of the panel. */
  .al-hero__support {
    margin-top: 16px;
    max-width: 62ch;
    font-size: 20px;
    line-height: 1.72;
    color: inherit;
    font-weight: 400;
  }

  .al-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 40px;
  }

  /* --- pillar strip ------------------------------------------------------ */
  /* Its own row, on the hero's ash ground -- not a wash over a picture. */
  .al-hero__pillars {
    grid-row: 2;
    position: relative;
    z-index: 2;
    background: var(--color-ash);
    border-top: 1px solid var(--color-rule-dark);
  }

  .al-hero__pillars-grid {
    padding-block: clamp(28px, 3.5vw, 40px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: clamp(24px, 3vw, 44px);
  }

  .al-pillar {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-left: 18px;
    border-left: 1px solid var(--color-rule-dark-soft);
  }

  .al-pillar__n {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-gold-on-ash);
    letter-spacing: 0.2em;
  }

  .al-pillar__code {
    font-family: var(--font-display);
    font-size: 17px;
    letter-spacing: 0.06em;
  }

  .al-pillar__full {
    font-size: 12.5px;
    color: var(--color-on-dark-68);
    line-height: 1.5;
  }

  /* --- narrow screens ---------------------------------------------------- */
  /* All three stay up at every width, per the brief. On a 390px phone that is
     three 130px strips -- narrow, but these are wall-texture photographs
     rather than pictures anyone has to read, and dropping to one would mean
     two of the three were not "displayed at all times". */

  @media (prefers-reduced-motion: reduce) {
    .al-hero__copy[data-in] > :global(*) {
      animation: none;
    }
  }
</style>
