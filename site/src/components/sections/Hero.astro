---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import { pillars } from '../../content/site';
import { srcSet } from '../../lib/media';
import type { SlotImage as SlotImageType } from '../../lib/media';

/**
 * One photograph fills the hero and the copy arrives over it.
 *
 * This was a wall of three portrait columns until the client swapped the home
 * page's backdrop with the one behind "Your Design. Our Manufacturing." -- the
 * three portraits moved to that section (see CustomSection) and its wide
 * landscape came here. A landscape frame is what a full-bleed hero wants: the
 * 2000x1333 source covers a 1366x880 hero at 1.0x with a modest crop, where a
 * portrait would have had to upscale.
 *
 * The photograph is admin-managed through the `alicore-hero` slot, position 1.
 * An empty slot falls back to the file shipped in public/hero/, so the hero is
 * never a bare grey band on a first deploy or a local build without database
 * credentials.
 */

/** The shipped fallback, at the two widths a hero actually needs. 2000 is the
    source's own width -- no upscaling at any viewport. */
const FALLBACK_SRC = '/hero/hero-wide-2000.webp';
const FALLBACK_SRCSET = '/hero/hero-wide-1280.webp 1280w, /hero/hero-wide-2000.webp 2000w';

interface Props {
  /** The `alicore-hero` slot. Absent -> the shipped photograph. */
  image?: SlotImageType;
}
const { image } = Astro.props;

const frame = image
  ? { src: image.webp[2000] ?? image.fallback, srcset: srcSet(image) }
  : { src: FALLBACK_SRC, srcset: FALLBACK_SRCSET };
---

<section id="top" class="al-hero">
  <div class="al-hero__stage" aria-hidden="true">
    <img
      class="al-hero__frame"
      src={frame.src}
      srcset={frame.srcset}
      sizes="100vw"
      alt=""
      width="2000"
      height="1333"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>

  <!-- The photograph is decorative: it carries no information the copy does
       not, and the hero's heading already says what the page is. The stage is
       aria-hidden and this description is what a screen reader gets instead. -->
  <p class="sr-only">Background: a photograph of a contemporary building facade.</p>

  <div class="al-container al-hero__inner">
    <div class="al-hero__copy al-photo-panel al-photo-panel--ink" data-hero-copy>
      <Eyebrow label="Architectural Products Manufacturer" ground="dark" />
      <h1 class="al-hero__title al-balance">
        Architectural Products. Engineered to <span class="al-hero__accent">Elevate</span>.
      </h1>
      <p class="al-hero__lead">
        Premium GFRC and FRP architectural solutions for contemporary buildings, facades and
        interiors.
      </p>
      <p class="al-hero__support">
        Alicore combines architectural design, engineering and advanced manufacturing to create
        durable, lightweight and highly customizable architectural elements for residential,
        commercial, hospitality and large-scale developments.
      </p>
      <div class="al-hero__cta">
        <Button href="/products" variant="gold">Explore Products</Button>
        <Button href="/contact" variant="outline">Request a Quote</Button>
      </div>
    </div>
  </div>

  <div class="al-hero__pillars">
    <div class="al-container al-hero__pillars-grid">
      {
        pillars.map((p) => (
          <div class="al-pillar">
            <span class="al-pillar__n">{p.n}</span>
            <span class="al-pillar__code">{p.code}</span>
            <span class="al-pillar__full">{p.full}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // The photograph is static. All this does is reveal the copy once the page
  // is ready.
  (() => {
    const copy = document.querySelector<HTMLElement>('[data-hero-copy]');
    if (!copy) return;
    // Reveal on the next frame so the transition has a start state to animate
    // from; setting it in the same frame as the class would jump.
    requestAnimationFrame(() => requestAnimationFrame(() => copy.setAttribute('data-in', '')));
  })();
</script>

<style>
  /* Two rows: the photographs and the copy share the first, stacked in one
     grid cell; the pillar strip gets the second, below the pictures.

     It used to sit on top of them behind a 0.62 band. With no band and no
     glyph outline the four labels held 3:1 across 59% of their pixels -- a
     word like PRECAST lands on dark planting and disappears. Putting the strip
     under the photographs rather than over them fixes that without veiling
     anything: the pictures end where it begins instead of being covered. */
  .al-hero {
    position: relative;
    background: var(--color-ash);
    color: var(--color-on-dark);
    min-height: min(880px, 92vh);
    display: grid;
    /* minmax(0, 1fr), not 1fr. A grid item's automatic minimum size is its
       min-content width, so an `auto`/`1fr` column is free to grow past the
       viewport to fit its contents -- and the pillar strip's
       repeat(auto-fit, minmax(210px, 1fr)) reports a min-content of four full
       columns when it is measured against an indefinite width. That made every
       row 952px wide inside a 390px phone (4x210 + 3x24 gap + 40 padding), and
       overflow:hidden below cropped the hero copy rather than wrapping it.
       This was a flex column before and the bug could not arise: a column flex
       container stretches its items to its own width, so nothing was ever
       sized by content. Pinning the minimum to 0 restores that. */
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    overflow: hidden;
    isolation: isolate;
  }

  /* --- the photograph ---------------------------------------------------- */
  .al-hero__stage {
    grid-area: 1 / 1;
    z-index: 0;
    position: relative;
    overflow: hidden;
    background: var(--color-ash-2);
  }

  .al-hero__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- the copy --------------------------------------------------------- */
  /* The copy leaves the centred container. .al-container caps itself at
     --al-container (1320px) and centres what is left over, which on a wide
     screen is dead margin down the side of a full-bleed photograph: at 1920
     it started the copy 384px in, a third of that being margin nothing else
     was using. Here the cap and the centring both come off, so the copy sits
     one page gutter from the window edge at any width and the photograph has
     the rest. The pillar strip below does the same, so the whole section
     shares one left edge. */
  .al-hero__inner {
    grid-area: 1 / 1;
    align-self: end;
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-block: clamp(56px, 8vh, 110px) clamp(40px, 6vw, 72px);
  }

  /* NO ground behind the copy -- no panel, no scrim, no tint. The photographs
     are the point of this section and anything laid behind the type hides part
     of them. That is a rule for the whole site, not a choice made here.

     Which means the copy has to carry itself on colour alone, and the colour
     changed with the photograph. The three portraits this hero used to show
     were dark enough for warm white; the landscape that replaced them is a
     pale building under a bright sky, and white measured 1.4-2.4:1 across it
     -- 7.4% of the copy's glyph pixels at 3:1, which is the lead paragraph
     being white on white. Near-black holds 3:1 across 97.1% of them, median
     7-12:1, so the panel is --ink and the hero is a light-ground section now:
     the outline button and the focus ring went with it.

     `al-photo-panel--plain` is the one-line way back to white. */
  /* No horizontal padding: it was a second inset on top of the container's
     gutter, and with the container gone the gutter is the whole left margin. */
  .al-hero__copy {
    max-width: 640px;
    padding-block: clamp(26px, 3vw, 40px);
  }

  /* Each element rises in turn once the page is ready. Scoped to [data-in],
     which the script sets -- so if the script never runs the copy is simply
     visible, never stuck at opacity 0. */
  .al-hero__copy > :global(*) {
    opacity: 1;
  }

  .al-hero__copy[data-in] > :global(*) {
    animation: al-hero-rise 1.1s var(--ease-premium) both;
  }

  .al-hero__copy[data-in] > :global(:nth-child(1)) { animation-delay: 0.15s; }
  .al-hero__copy[data-in] > :global(:nth-child(2)) { animation-delay: 0.32s; }
  .al-hero__copy[data-in] > :global(:nth-child(3)) { animation-delay: 0.49s; }
  .al-hero__copy[data-in] > :global(:nth-child(4)) { animation-delay: 0.66s; }
  .al-hero__copy[data-in] > :global(:nth-child(5)) { animation-delay: 0.83s; }

  @keyframes al-hero-rise {
    from {
      opacity: 0;
      transform: translateY(34px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .al-hero__title {
    font-family: var(--font-display);
    /* Up from 400. With no panel behind it the stroke has to hold its own
       against a facade that can be any tone. */
    font-weight: 500;
    font-size: clamp(40px, 6.6vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.015em;
    margin-top: 26px;
    max-width: 17ch;
  }

  /* Client-specified #f2b229. Brighter and more saturated than the button
     fill it replaces, which was very nearly the tone of the limestone behind
     it -- see the measurements on --color-gold-accent in tokens.css. */
  .al-hero__accent {
    color: var(--color-gold-accent);
  }

  /* font-weight was declared twice here, 600 and then 300, so the lead had
     been rendering light the whole time -- visibly fainter than the support
     paragraph directly beneath it. One declaration now, at 400: the 600 was
     there to give the glyph outline more stem to hold, and the outline is
     gone. Same weight as every stage panel lead on the site. */
  .al-hero__lead {
    margin-top: 26px;
    max-width: 52ch;
    font-size: clamp(21px, 2vw, 25px);
    line-height: 1.58;
    color: inherit;
    font-weight: 400;
  }

  /* Was --color-ink: black copy inside a panel whose other text is white,
     which only worked while the blur guaranteed a light ground behind it.
     With the picture bare it joins the rest of the panel. */
  .al-hero__support {
    margin-top: 16px;
    max-width: 62ch;
    font-size: 20px;
    line-height: 1.72;
    color: inherit;
    font-weight: 400;
  }

  .al-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 40px;
  }

  /* --- pillar strip ------------------------------------------------------ */
  /* Its own row, on the hero's ash ground -- not a wash over a picture. */
  .al-hero__pillars {
    grid-row: 2;
    position: relative;
    z-index: 2;
    background: var(--color-ash);
    border-top: 1px solid var(--color-rule-dark);
  }

  /* Same escape from the centred container as the copy above it: with the two
     on different left edges the strip read as a misalignment rather than as a
     second band. The 18px on .al-pillar is its own rule's offset, so the first
     hairline lands on the gutter and its label sits just inside it. */
  .al-hero__pillars-grid {
    max-width: none;
    margin-inline: 0;
    padding-block: clamp(28px, 3.5vw, 40px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: clamp(24px, 3vw, 44px);
  }

  .al-pillar {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-left: 18px;
    border-left: 1px solid var(--color-rule-dark-soft);
  }

  .al-pillar__n {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-gold-on-ash);
    letter-spacing: 0.2em;
  }

  .al-pillar__code {
    font-family: var(--font-display);
    font-size: 17px;
    letter-spacing: 0.06em;
  }

  .al-pillar__full {
    font-size: 12.5px;
    color: var(--color-on-dark-68);
    line-height: 1.5;
  }

  /* --- narrow screens ---------------------------------------------------- */
  /* All three stay up at every width, per the brief. On a 390px phone that is
     three 130px strips -- narrow, but these are wall-texture photographs
     rather than pictures anyone has to read, and dropping to one would mean
     two of the three were not "displayed at all times". */

  @media (prefers-reduced-motion: reduce) {
    .al-hero__copy[data-in] > :global(*) {
      animation: none;
    }
  }
</style>
