---
import Eyebrow from '../ui/Eyebrow.astro';
import MediaStage from '../ui/MediaStage.astro';
import PhotoBackdrop from '../ui/PhotoBackdrop.astro';
import { journey, quality } from '../../content/sections';
import type { SlotImage as SlotImageType } from '../../lib/media';

interface Props {
  /** Two photographs, shown side by side. Positions 1 and 2 of alicore-factory. */
  images: SlotImageType[];
  /** The `alicore-journey` slot, behind the six stages. Absent -> flat ground. */
  journeyImage?: SlotImageType;
  headingLevel?: 'h1' | 'h2';
}
const { images, journeyImage, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const hasJourneyPhoto = Boolean(journeyImage);
---

<section id="manufacturing">
  <!-- Production floor as the stage, two photographs side by side. The
       six-step journey stays below: as a numbered sequence it has to be read
       in order, and a panel floating over a photograph is the wrong place to
       ask that of anyone. -->
  <MediaStage
    slotId="alicore-factory"
    placeholder="Production floor: GFRC spray / mould work"
    images={images}
    align="right"
    ground="ink2"
  >
    <Eyebrow label="Manufacturing" ground="dark" />
    <Heading class="al-mfg__title al-balance">From Design to Reality</Heading>
    <p class="al-mfg__intro">
      Our manufacturing approach combines material expertise, craftsmanship and controlled
      production processes to transform architectural concepts into finished products.
    </p>
  </MediaStage>

  <div class={`al-section al-mfg__stages${hasJourneyPhoto ? ' al-mfg__stages--photo al-photo-sec' : ''}`}>
    {
      hasJourneyPhoto && (
        <PhotoBackdrop
          slot="alicore-journey"
          placeholder="Wide photograph behind the Design / Mould Development steps"
          image={journeyImage}
          ground="light"
        />
      )
    }
    <div class="al-container al-mfg__below al-photo-sec__inner">
      <ol class="al-journey al-stagger" data-reveal>
        {
          journey.map((j) => (
            <li class="al-journey__row">
              <div class="al-journey__n">{j.n}</div>
              <div>
                <div class="al-journey__name">{j.name}</div>
                <div class="al-journey__desc">{j.desc}</div>
              </div>
            </li>
          ))
        }
      </ol>

      <!-- Quality. Deliberately carries no certification or standards claim --
           the brief forbids it without verified evidence. -->
      <div class="al-quality" data-reveal>
        <h3 class="al-quality__title">{quality.heading}</h3>
        <p class="al-quality__body">{quality.body}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .al-mfg__title {
    font-family: var(--font-display);
    font-weight: 500;
    /* See AboutSection: panel width is fixed, so type must not scale with the
       viewport or it wraps to five lines on a wide screen. */
    font-size: clamp(29px, 2.6vw, 40px);
    line-height: 1.12;
    margin-top: 16px;
  }

  /* Was --color-ink, which only read while the panel's blur guaranteed a
     light ground behind it. Bare picture: it joins the rest of the panel. */
  .al-mfg__intro {
    margin-top: 16px;
    font-size: 19px;
    line-height: 1.7;
    color: var(--color-on-dark);
    font-weight: 600;
  }

  .al-mfg__below {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .al-journey {
    list-style: none;
  }

  .al-journey__row {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
    padding: 20px 0;
    align-items: center;
  }

  .al-journey__row {
    border-bottom: 1px solid var(--color-rule);
  }

  .al-journey__n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-gold-ink);
  }

  .al-journey__name {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 400;
  }

  .al-journey__desc {
    font-size: 14px;
    color: rgb(18 17 15 / 0.58);
    margin-top: 6px;
    line-height: 1.6;
  }

  .al-quality {
    border: 1px solid var(--color-rule);
    padding: 34px 32px;
  }

  /* Over a photograph the panel keeps no ground of its own -- see the
     over-a-photograph block below. */
  .al-mfg__stages:not(.al-mfg__stages--photo) .al-quality {
    background: var(--color-panel);
  }

  .al-quality__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 24px;
  }

  .al-quality__body {
    font-size: 15px;
    line-height: 1.7;
    color: rgb(18 17 15 / 0.65);
    margin-top: 14px;
  }

  /* --- over a photograph -------------------------------------------------
     Nothing behind this copy: no wash, no blur, no panel. The picture here is
     a pale facade against a pale sky, and measured under the glyphs that is
     the easy case -- black holds 5.0:1 on the stage descriptions and 6.5:1 on
     the names with no help at all, so it needs none.

     What it must not be is white, which is what the client saw and objected
     to: white on a white building. And it should not be only black either, so
     the numbers and the rule take the deep brown, the one warm colour that
     survives sitting directly on a bright photograph -- 4.0:1 on the numbers,
     where gold manages 1.0-2.2:1 at any shade still worth calling gold. */
  .al-mfg__stages--photo .al-journey {
    padding: 0;
  }

  .al-mfg__stages--photo .al-journey__row {
    border-bottom-color: var(--color-rule-photo);
  }

  .al-mfg__stages--photo .al-journey__row:last-child {
    border-bottom: none;
  }

  .al-mfg__stages--photo .al-quality {
    border: none;
    border-left: 2px solid var(--color-brown-deep);
    padding: 4px 0 6px clamp(18px, 2vw, 26px);
  }

  /* 20px/700 is large text, so brown's 4.0:1 clears the 3:1 bar with room. */
  .al-mfg__stages--photo .al-journey__n {
    color: var(--color-brown-deep);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .al-mfg__stages--photo .al-journey__name,
  .al-mfg__stages--photo .al-quality__title {
    color: var(--color-brown-deep);
  }

  .al-mfg__stages--photo .al-journey__name {
    font-size: 21px;
    font-weight: 600;
  }

  .al-mfg__stages--photo .al-quality__title {
    font-size: 26px;
    font-weight: 600;
  }

  /* Full black, up a size and a weight: 0.72 black was what a wash allowed,
     and there is no wash now. */
  .al-mfg__stages--photo .al-journey__desc,
  .al-mfg__stages--photo .al-quality__body {
    color: var(--color-ink);
    font-weight: 500;
  }

  .al-mfg__stages--photo .al-journey__desc {
    font-size: 15px;
    line-height: 1.65;
  }

  .al-mfg__stages--photo .al-quality__body {
    font-size: 15.5px;
    line-height: 1.7;
  }

</style>
