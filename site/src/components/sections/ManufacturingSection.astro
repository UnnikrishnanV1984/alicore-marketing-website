---
import Eyebrow from '../ui/Eyebrow.astro';
import SlotImage from '../ui/SlotImage.astro';
import { journey, quality } from '../../content/sections';
import type { SlotImage as SlotImageType } from '../../lib/media';

interface Props {
  image?: SlotImageType;
  headingLevel?: 'h1' | 'h2';
}
const { image, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<section id="manufacturing" class="al-section">
  <div class="al-container al-mfg">
    <div>
      <Eyebrow label="Manufacturing" />
      <Heading class="al-mfg__title">From Design to Reality</Heading>
      <p class="al-mfg__intro">
        Our manufacturing approach combines material expertise, craftsmanship and controlled
        production processes to transform architectural concepts into finished products.
      </p>
      <div class="al-mfg__figure">
        <SlotImage
          slot="alicore-factory"
          placeholder="Production floor: GFRC spray / mould work"
          image={image}
          ratio="16/10"
          sizes="(max-width: 900px) 100vw, 45vw"
        />
      </div>
    </div>

    <div>
      <ol class="al-journey">
        {
          journey.map((j) => (
            <li class="al-journey__row">
              <div class="al-journey__n">{j.n}</div>
              <div>
                <div class="al-journey__name">{j.name}</div>
                <div class="al-journey__desc">{j.desc}</div>
              </div>
            </li>
          ))
        }
      </ol>

      <!-- Quality. Deliberately carries no certification or standards claim --
           the brief forbids it without verified evidence. -->
      <div class="al-quality">
        <h3 class="al-quality__title">{quality.heading}</h3>
        <p class="al-quality__body">{quality.body}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .al-mfg {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .al-mfg__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(30px, 3.8vw, 50px);
    line-height: 1.08;
    margin-top: 20px;
  }

  .al-mfg__intro {
    margin-top: 22px;
    font-size: 16px;
    line-height: 1.75;
    color: rgb(18 17 15 / 0.65);
    max-width: 52ch;
  }

  .al-mfg__figure {
    margin-top: 36px;
  }

  .al-journey {
    list-style: none;
  }

  .al-journey__row {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--color-rule);
    align-items: center;
  }

  .al-journey__n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-gold-ink);
  }

  .al-journey__name {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 400;
  }

  .al-journey__desc {
    font-size: 14px;
    color: rgb(18 17 15 / 0.58);
    margin-top: 6px;
    line-height: 1.6;
  }

  .al-quality {
    border: 1px solid var(--color-rule);
    padding: 34px 32px;
    margin-top: 44px;
    background: var(--color-panel);
  }

  .al-quality__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 24px;
  }

  .al-quality__body {
    font-size: 15px;
    line-height: 1.7;
    color: rgb(18 17 15 / 0.65);
    margin-top: 14px;
  }
</style>
