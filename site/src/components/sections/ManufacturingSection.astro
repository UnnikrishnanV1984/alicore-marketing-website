---
import Eyebrow from '../ui/Eyebrow.astro';
import MediaStage from '../ui/MediaStage.astro';
import PhotoBackdrop from '../ui/PhotoBackdrop.astro';
import { journey, quality } from '../../content/sections';
import type { SlotImage as SlotImageType } from '../../lib/media';

interface Props {
  /** Two photographs, shown side by side. Positions 1 and 2 of alicore-factory. */
  images: SlotImageType[];
  /** The `alicore-journey` slot, behind the six stages. Absent -> flat ground. */
  journeyImage?: SlotImageType;
  headingLevel?: 'h1' | 'h2';
}
const { images, journeyImage, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const hasJourneyPhoto = Boolean(journeyImage);
---

<section id="manufacturing">
  <!-- Production floor as the stage, two photographs side by side. The
       six-step journey stays below: as a numbered sequence it has to be read
       in order, and a panel floating over a photograph is the wrong place to
       ask that of anyone. -->
  <MediaStage
    slotId="alicore-factory"
    placeholder="Production floor: GFRC spray / mould work"
    images={images}
    align="right"
    ground="ink2"
  >
    <Eyebrow label="Manufacturing" ground="dark" />
    <Heading class="al-mfg__title al-balance">From Design to Reality</Heading>
    <p class="al-mfg__intro">
      Our manufacturing approach combines material expertise, craftsmanship and controlled
      production processes to transform architectural concepts into finished products.
    </p>
  </MediaStage>

  <div class={`al-section al-mfg__stages${hasJourneyPhoto ? ' al-mfg__stages--photo al-photo-sec' : ''}`}>
    {
      hasJourneyPhoto && (
        <PhotoBackdrop
          slot="alicore-journey"
          placeholder="Wide photograph behind the Design / Mould Development steps"
          image={journeyImage}
          ground="light"
        />
      )
    }
    <div class="al-container al-mfg__below al-photo-sec__inner">
      <ol class={`al-journey al-stagger${hasJourneyPhoto ? ' al-photo-panel' : ''}`} data-reveal>
        {
          journey.map((j) => (
            <li class="al-journey__row">
              <div class="al-journey__n al-photo-accent">{j.n}</div>
              <div>
                <div class="al-journey__name">{j.name}</div>
                <div class="al-journey__desc">{j.desc}</div>
              </div>
            </li>
          ))
        }
      </ol>

      <!-- Quality. Deliberately carries no certification or standards claim --
           the brief forbids it without verified evidence. -->
      <div class={`al-quality${hasJourneyPhoto ? ' al-photo-panel' : ''}`} data-reveal>
        <h3 class="al-quality__title">{quality.heading}</h3>
        <p class="al-quality__body">{quality.body}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .al-mfg__title {
    font-family: var(--font-display);
    font-weight: 500;
    /* See AboutSection: panel width is fixed, so type must not scale with the
       viewport or it wraps to five lines on a wide screen. */
    font-size: clamp(26px, 2.3vw, 36px);
    line-height: 1.12;
    margin-top: 16px;
  }

  /* Was --color-ink, which only read while the panel's blur guaranteed a
     light ground behind it. Bare picture: it joins the rest of the panel. */
  .al-mfg__intro {
    margin-top: 16px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-on-dark);
    font-weight: 500;
  }

  .al-mfg__below {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .al-journey {
    list-style: none;
  }

  .al-journey__row {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
    padding: 20px 0;
    align-items: center;
  }

  .al-journey__row {
    border-bottom: 1px solid var(--color-rule);
  }

  .al-journey__n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-gold-ink);
  }

  .al-journey__name {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 400;
  }

  .al-journey__desc {
    font-size: 14px;
    color: rgb(18 17 15 / 0.58);
    margin-top: 6px;
    line-height: 1.6;
  }

  .al-quality {
    border: 1px solid var(--color-rule);
    padding: 34px 32px;
  }

  /* Over a photograph the panel keeps no ground of its own -- see the
     over-a-photograph block below. */
  .al-mfg__stages:not(.al-mfg__stages--photo) .al-quality {
    background: var(--color-panel);
  }

  .al-quality__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 24px;
  }

  .al-quality__body {
    font-size: 15px;
    line-height: 1.7;
    color: rgb(18 17 15 / 0.65);
    margin-top: 14px;
  }

  /* --- over a photograph -------------------------------------------------
     The photograph behind these stages is a pale facade -- white building,
     white sky -- and the copy was white too, which is what the client saw and
     objected to. It now sits on an ash ground: a colour from the site's own
     palette rather than the white wash it had, no blur, and transparent
     enough that the building still reads through it.

     Warm white on that ground measures 6.5:1, and the stage number can
     finally be gold again: gold is hopeless on the bare facade (1.0-1.8:1
     whatever the shade) but reaches 3.7:1 here in its lighter tone, which
     carries it at large-text size. Ground and text colour come from
     .al-photo-panel / .al-photo-accent in global.css. */
  .al-mfg__stages--photo .al-journey {
    padding: 8px clamp(20px, 2.4vw, 30px);
  }

  .al-mfg__stages--photo .al-journey__row {
    border-bottom-color: rgb(246 244 239 / 0.16);
  }

  .al-mfg__stages--photo .al-journey__row:last-child {
    border-bottom: none;
  }

  .al-mfg__stages--photo .al-quality {
    border: none;
    border-left: 2px solid var(--color-gold-bright);
    padding: 30px clamp(20px, 2.4vw, 30px) 34px;
  }

  /* Large text, so the lighter gold clears its 3:1 bar with room. */
  .al-mfg__stages--photo .al-journey__n {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .al-mfg__stages--photo .al-journey__name,
  .al-mfg__stages--photo .al-quality__title {
    color: var(--color-on-dark);
  }

  .al-mfg__stages--photo .al-journey__name {
    font-size: 21px;
    font-weight: 500;
  }

  .al-mfg__stages--photo .al-quality__title {
    font-size: 26px;
    font-weight: 500;
  }

  /* 0.72 black was what a light wash allowed. On the ash ground the copy is
     warm white, a size up and a weight up so it is not hairline over a
     picture. */
  .al-mfg__stages--photo .al-journey__desc,
  .al-mfg__stages--photo .al-quality__body {
    /* Full warm white, not the 80% variant: measured on this ground 80%
       lands at 3.5:1, under the 4.5 bar for body copy. */
    color: var(--color-on-dark);
    font-weight: 500;
  }

  .al-mfg__stages--photo .al-journey__desc {
    font-size: 15px;
    line-height: 1.65;
  }

  .al-mfg__stages--photo .al-quality__body {
    font-size: 15.5px;
    line-height: 1.7;
  }

</style>
