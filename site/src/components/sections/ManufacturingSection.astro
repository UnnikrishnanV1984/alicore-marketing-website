---
import Eyebrow from '../ui/Eyebrow.astro';
import MediaStage from '../ui/MediaStage.astro';
import { journey, quality } from '../../content/sections';
import type { SlotImage as SlotImageType } from '../../lib/media';

interface Props {
  image?: SlotImageType;
  headingLevel?: 'h1' | 'h2';
}
const { image, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<section id="manufacturing">
  <!-- Production floor as the stage. The six-step journey stays below: as a
       numbered sequence it has to be read in order, and a panel floating over
       a photograph is the wrong place to ask that of anyone. -->
  <MediaStage
    slotId="alicore-factory"
    placeholder="Production floor: GFRC spray / mould work"
    image={image}
    align="right"
    ground="ink2"
  >
    <Eyebrow label="Manufacturing" ground="dark" />
    <Heading class="al-mfg__title al-balance">From Design to Reality</Heading>
    <p class="al-mfg__intro">
      Our manufacturing approach combines material expertise, craftsmanship and controlled
      production processes to transform architectural concepts into finished products.
    </p>
  </MediaStage>

  <div class="al-section">
    <div class="al-container al-mfg__below">
      <ol class="al-journey">
        {
          journey.map((j) => (
            <li class="al-journey__row">
              <div class="al-journey__n">{j.n}</div>
              <div>
                <div class="al-journey__name">{j.name}</div>
                <div class="al-journey__desc">{j.desc}</div>
              </div>
            </li>
          ))
        }
      </ol>

      <!-- Quality. Deliberately carries no certification or standards claim --
           the brief forbids it without verified evidence. -->
      <div class="al-quality">
        <h3 class="al-quality__title">{quality.heading}</h3>
        <p class="al-quality__body">{quality.body}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .al-mfg__title {
    font-family: var(--font-display);
    font-weight: 400;
    /* See AboutSection: panel width is fixed, so type must not scale with the
       viewport or it wraps to five lines on a wide screen. */
    font-size: clamp(26px, 2.3vw, 36px);
    line-height: 1.12;
    margin-top: 16px;
  }

  .al-mfg__intro {
    margin-top: 16px;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--color-on-dark-80);
    font-weight: 300;
  }

  .al-mfg__below {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .al-journey {
    list-style: none;
  }

  .al-journey__row {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--color-rule);
    align-items: center;
  }

  .al-journey__n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-gold-ink);
  }

  .al-journey__name {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 400;
  }

  .al-journey__desc {
    font-size: 14px;
    color: rgb(18 17 15 / 0.58);
    margin-top: 6px;
    line-height: 1.6;
  }

  .al-quality {
    border: 1px solid var(--color-rule);
    padding: 34px 32px;
    background: var(--color-panel);
  }

  .al-quality__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 24px;
  }

  .al-quality__body {
    font-size: 15px;
    line-height: 1.7;
    color: rgb(18 17 15 / 0.65);
    margin-top: 14px;
  }
</style>
