---
import Eyebrow from '../ui/Eyebrow.astro';
import SlotImage from '../ui/SlotImage.astro';
import { why } from '../../content/sections';
import type { SlotImage as SlotImageType } from '../../lib/media';

/**
 * "Why Choose Alicore?" -- six reasons over a full-bleed architectural
 * photograph, which is meant to be seen rather than covered.
 *
 * The photograph carries no full-height overlay; the only tint is a gradient
 * across the top third that the heading sits in. The cards are all but
 * transparent -- a 0.16 wash, there to mark the grid rather than to hold the
 * type -- so the picture reads straight through them.
 *
 * That leaves the type with no plate to sit on, which matters most for the
 * gold titles: gold is almost exactly the tone of sand and stone, so on this
 * photograph --color-gold measures 2.4:1 at the median and 1.2:1 across the
 * lit areas. Two things carry them instead:
 *
 *   - --color-gold-bright, lighter than the mid-tone golds used on solid
 *     grounds, so it separates from the picture rather than blending in; and
 *   - a soft dark shadow, which darkens the few pixels immediately around
 *     each glyph. Measured at the glyph edge that lifts the titles to about
 *     7:1, though WCAG scores text against the wider background and so does
 *     not credit it.
 *
 * The honest position: with a near-transparent card this section reads well
 * but does not clear AA by the letter over the brightest parts of the
 * picture. Raising `--why-card-tint` below is the single lever -- 0.60 puts
 * the gold at 4.5:1 -- at the cost of the transparency.
 *
 * With no photograph uploaded the section renders its original light
 * treatment -- black type on the page ground -- rather than a full-width
 * placeholder block.
 */
interface Props {
  headingLevel?: 'h1' | 'h2';
  /** The `alicore-why` slot. Absent -> the original light treatment. */
  image?: SlotImageType;
}

const { headingLevel = 'h2', image } = Astro.props;
const Heading = headingLevel;
const hasPhoto = Boolean(image);
---

<section class={`al-section al-why${hasPhoto ? ' al-why--photo' : ''}`}>
  {
    hasPhoto && (
      <div class="al-why__bg" aria-hidden="true">
        <SlotImage
          slot="alicore-why"
          placeholder="Wide architectural photograph used behind the Why Choose Alicore section"
          image={image}
          ratio="16/9"
          fit="cover"
          sizes="100vw"
          class="al-why__slot"
        />
      </div>
    )
  }

  <div class="al-container al-why__inner">
    <Eyebrow label="Why Alicore" ground={hasPhoto ? 'shaded' : 'light'} />
    <Heading class="al-why__title">Why Choose Alicore?</Heading>

    <div class="al-hairline-grid al-why__grid">
      {
        why.map((w) => (
          <div class="al-why__card">
            <h3 class="al-why__name">{w.name}</h3>
            <p class="al-why__desc">{w.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .al-why {
    position: relative;
    isolation: isolate;

    /* The one lever between "the picture shows through" and "the type clears
       AA on its own". 0.16 is nearly clear; 0.60 puts the gold titles at
       4.5:1 over the brightest part of the photograph. */
    --why-card-tint: 0.16;
  }

  /* --- the photograph ---------------------------------------------------
     Absolutely positioned so it is a background layer: the container is the
     only thing in flow, so the section stays self-sizing however tall the
     copy becomes. Same approach as MediaStage. */
  .al-why__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--color-ink-2);
    z-index: 0;
  }

  /* height:100% against a min-height-only parent resolves to auto and lets
     the photograph's own ratio drive the section height. Filling absolutely
     is what keeps it a background rather than content. */
  .al-why__bg :global(.al-slot) {
    position: absolute;
    inset: 0;
    height: auto;
    aspect-ratio: auto;
  }

  /* The only tint on the picture, and it is gone before the cards start.
     The heading has no card behind it, so it needs the photograph under it
     to be predictable; the sky is also the part of an architectural
     photograph least worth protecting. */
  .al-why__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(18 17 15 / 0.62) 0%,
      rgb(18 17 15 / 0.52) 20%,
      rgb(18 17 15 / 0.34) 34%,
      rgb(18 17 15 / 0) 50%
    );
  }

  .al-why__inner {
    position: relative;
    z-index: 1;
  }

  .al-why__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(30px, 3.8vw, 50px);
    line-height: 1.08;
    margin-top: 20px;
  }

  /* Three across, so the six reasons fill two complete rows. auto-fit alone
     resolves to four columns on a desktop and leaves two empty cells inside
     the grid's border -- invisible against the flat page ground this section
     used to have, but a pair of holes once a photograph shows through them. */
  .al-why__grid {
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    margin-top: 52px;
  }

  @media (min-width: 1000px) {
    .al-why__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .al-why__card {
    background: var(--color-bg);
    padding: 40px 34px 44px;
    transition: background-color 0.3s var(--ease-premium);
  }

  .al-why__card:hover {
    background: var(--color-panel);
  }

  .al-why__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 21px;
    line-height: 1.2;
  }

  .al-why__desc {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--color-on-light-60);
    margin-top: 14px;
  }

  /* --- over a photograph ------------------------------------------------- */
  .al-why--photo .al-why__card {
    background: rgb(18 17 15 / var(--why-card-tint));
    -webkit-backdrop-filter: blur(2px) saturate(1);
    backdrop-filter: blur(2px) saturate(1);
  }

  .al-why--photo .al-why__card:hover {
    background: rgb(18 17 15 / calc(var(--why-card-tint) + 0.14));
  }

  .al-why--photo .al-why__title {
    color: var(--color-on-dark);
  }

  .al-why--photo .al-why__name {
    color: var(--color-gold-bright);
  }

  .al-why--photo .al-why__desc {
    color: var(--color-on-dark);
  }

  /* The shadow is the type's plate now that the card is not one. Two layers:
     a tight one that draws the edge of each letter, and a wide soft one that
     dims the picture immediately around the text block. Kept low enough not
     to read as a glow. */
  .al-why--photo .al-why__name,
  .al-why--photo .al-why__desc {
    text-shadow:
      0 0 3px rgb(18 17 15 / 0.92),
      0 1px 2px rgb(18 17 15 / 0.88),
      0 0 14px rgb(18 17 15 / 0.8),
      0 0 34px rgb(18 17 15 / 0.6);
  }

  .al-why--photo .al-why__title {
    text-shadow:
      0 1px 3px rgb(18 17 15 / 0.5),
      0 0 28px rgb(18 17 15 / 0.42);
  }

  /* Light hairlines, since the grid now sits over a photograph. Slightly
     stronger than the standard rule: with the cards this transparent, the
     grid is the only thing giving the six reasons their structure. */
  .al-why--photo .al-why__grid {
    background: rgb(246 244 239 / 0.3);
    border-color: rgb(246 244 239 / 0.3);
  }

  /* Without backdrop-filter the wash alone separates the card from the
     picture, so it goes up a little. */
  @supports not (backdrop-filter: blur(1px)) {
    .al-why--photo .al-why__card {
      background: rgb(18 17 15 / calc(var(--why-card-tint) + 0.16));
    }
  }

  /* Phones: the stacked cards make the section far taller than the 16:9
     photograph, so it crops to a narrow centre strip. Anchoring the image to
     its centre keeps the subject rather than the sky or the ground. */
  @media (max-width: 640px) {
    .al-why__bg :global(img) {
      object-position: center;
    }

    .al-why--photo .al-why__card {
      padding: 32px 26px 36px;
    }
  }
</style>
