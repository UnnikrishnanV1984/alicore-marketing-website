---
import Eyebrow from '../ui/Eyebrow.astro';
import SlotImage from '../ui/SlotImage.astro';
import { why } from '../../content/sections';
import type { SlotImage as SlotImageType } from '../../lib/media';

/**
 * "Why Choose Alicore?" -- six reasons over a full-bleed architectural
 * photograph, which is meant to be seen rather than covered.
 *
 * Nothing is laid over the picture. No gradient across the top, no wash on the
 * cards, no soft halo around the type -- the photographs are the point of these
 * sections and anything behind the copy hides part of them. That is a rule for
 * the whole site.
 *
 * Which leaves the type carrying itself, and gold cannot: gold is almost
 * exactly the tone of sand and stone, so on this photograph --color-gold
 * measures 2.4:1 at the median and 1.2:1 across the lit areas. The answer is
 * the warm-edge treatment in global.css -- deep colour with a 1px cream ring
 * around each glyph. Measured on the glyph pixels with every overlay removed:
 *
 *   white + 1px black stroke   >=3:1 97.6%   >=4.5:1 85.9%
 *   brown-deep + 1px cream     >=3:1 99.7%   >=4.5:1 99.0%
 *
 * so the section clears AA on the bare photograph, which it never did behind
 * the wash it used to carry.
 *
 * With no photograph uploaded the section renders its original light
 * treatment -- black type on the page ground -- rather than a full-width
 * placeholder block.
 */
interface Props {
  headingLevel?: 'h1' | 'h2';
  /** The `alicore-why` slot. Absent -> the original light treatment. */
  image?: SlotImageType;
}

const { headingLevel = 'h2', image } = Astro.props;
const Heading = headingLevel;
const hasPhoto = Boolean(image);
---

<section class={`al-section al-why${hasPhoto ? ' al-why--photo al-photo-panel al-photo-panel--warm-edge' : ''}`}>
  {
    hasPhoto && (
      <div class="al-why__bg" aria-hidden="true" data-reveal>
        <SlotImage
          slot="alicore-why"
          placeholder="Wide architectural photograph used behind the Why Choose Alicore section"
          image={image}
          ratio="16/9"
          fit="cover"
          sizes="100vw"
          class="al-why__slot"
        />
      </div>
    )
  }

  <div class="al-container al-why__inner">
    <div class="al-why__head al-stagger" data-reveal>
      {/* 'dark' means inherit -- it takes the warm-edge colour and ring from
          the section. 'shaded' was white, which was legible against the
          gradient that used to cover the top of this picture. */}
      <Eyebrow label="Why Alicore" ground={hasPhoto ? 'dark' : 'light'} />
      <Heading class="al-why__title">Why Choose Alicore?</Heading>
    </div>

    <div class="al-hairline-grid al-why__grid al-stagger" data-reveal>
      {
        why.map((w) => (
          <div class="al-why__card">
            <h3 class="al-why__name">{w.name}</h3>
            <p class="al-why__desc">{w.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .al-why {
    position: relative;
    isolation: isolate;
  }

  /* --- the photograph ---------------------------------------------------
     Absolutely positioned so it is a background layer: the container is the
     only thing in flow, so the section stays self-sizing however tall the
     copy becomes. Same approach as MediaStage. */
  .al-why__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--color-ash-2);
    z-index: 0;
  }

  /* height:100% against a min-height-only parent resolves to auto and lets
     the photograph's own ratio drive the section height. Filling absolutely
     is what keeps it a background rather than content. */
  .al-why__bg :global(.al-slot) {
    position: absolute;
    inset: 0;
    height: auto;
    aspect-ratio: auto;
  }

  .al-why__inner {
    position: relative;
    z-index: 1;
  }

  /* The photograph settles out of a slow push-in as the section arrives, the
     same motion MediaStage and PhotoBackdrop use. Scaling down to exactly 1
     means no edge is ever exposed. Behind [data-reveal-ready], so a script
     failure costs the motion and never the picture. */
  :global([data-reveal-ready]) .al-why__bg :global(.al-slot) {
    transform: scale(1.08);
    transition: transform 2.4s cubic-bezier(0.16, 0.72, 0.24, 1);
  }

  :global([data-reveal-ready]) .al-why__bg[data-revealed] :global(.al-slot) {
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-reveal-ready]) .al-why__bg :global(.al-slot) {
      transform: none;
      transition: none;
    }
  }

  .al-why__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(30px, 3.8vw, 50px);
    line-height: 1.08;
    margin-top: 20px;
  }

  /* Three across, so the six reasons fill two complete rows. auto-fit alone
     resolves to four columns on a desktop and leaves two empty cells inside
     the grid's border -- invisible against the flat page ground this section
     used to have, but a pair of holes once a photograph shows through them. */
  .al-why__grid {
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    margin-top: 52px;
  }

  @media (min-width: 1000px) {
    .al-why__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .al-why__card {
    background: var(--color-bg);
    padding: 40px 34px 44px;
    transition: background-color 0.3s var(--ease-premium);
  }

  .al-why__card:hover {
    background: var(--color-panel);
  }

  .al-why__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 21px;
    line-height: 1.2;
  }

  .al-why__desc {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--color-on-light-60);
    margin-top: 14px;
  }

  /* --- over a photograph -------------------------------------------------
     The cards have no ground at all: the photograph runs straight through
     where the wash used to be, and the grid hairlines are the only thing
     giving the six reasons their structure. Colour and the cream glyph ring
     come from .al-photo-panel--warm-edge on the section. */
  /* .al-hairline-grid draws its lines by filling the container and letting
     1px gaps show through between opaque cells. Transparent cells turn that
     fill into a tinted rectangle across the whole grid -- a ground behind the
     copy by the back door. So the container carries no fill here and each
     card draws its own hairline instead, which meets its neighbour's in the
     1px gap. */
  .al-why--photo .al-why__card {
    background: transparent;
    box-shadow: 0 0 0 1px var(--color-rule-photo);
  }

  .al-why--photo .al-why__card:hover {
    background: transparent;
  }

  /* gold-bright was chosen to separate from the picture while a dark wash sat
     under it. With the wash gone it is the colour of the sandstone -- 1.2:1
     across the lit areas. Deep gold plus the ring reads instead. */
  .al-why--photo .al-why__title,
  .al-why--photo .al-why__name {
    color: var(--color-gold-deep);
  }

  .al-why--photo .al-why__desc {
    color: inherit;
  }

  /* Dark hairlines now: 30% white was legible against a darkened picture and
     is nothing against a bright one. No fill -- see the card rule above. */
  .al-why--photo .al-why__grid {
    background: transparent;
    border-color: var(--color-rule-photo);
  }

  /* Phones: the stacked cards make the section far taller than the 16:9
     photograph, so it crops to a narrow centre strip. Anchoring the image to
     its centre keeps the subject rather than the sky or the ground. */
  @media (max-width: 640px) {
    .al-why__bg :global(img) {
      object-position: center;
    }

    .al-why--photo .al-why__card {
      padding: 32px 26px 36px;
    }
  }
</style>
