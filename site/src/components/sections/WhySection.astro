---
import Eyebrow from '../ui/Eyebrow.astro';
import SlotImage from '../ui/SlotImage.astro';
import { why } from '../../content/sections';
import type { SlotImage as SlotImageType } from '../../lib/media';

/**
 * "Why Choose Alicore?" -- six reasons on a full-bleed architectural
 * photograph, which is meant to be seen rather than washed out.
 *
 * The photograph carries NO full-height overlay: it renders at its own
 * brightness, and the only tint anywhere is a gradient across the top third
 * that the heading sits in. Everything below -- the whole subject of the
 * picture -- is untouched.
 *
 * The cards are therefore dark glass rather than a light plate. That is what
 * makes an untinted photograph survivable: a light card has to out-lighten
 * whatever is behind it before black type is readable, which is exactly the
 * whitewash we are trying to avoid, whereas a dark card only has to darken,
 * and darkening a photograph still shows the photograph. Measured over the
 * brightest backdrop inside the card rectangle, warm-white type on the glass
 * reaches 4.7:1 -- the worst case for light text, since light text fails
 * against bright backdrops, not dark ones.
 *
 * The one thing that could not follow the design is the index number: gold
 * measures 2.2:1 on this glass, so 01-06 are warm white here. Restoring the
 * gold is a one-line change if the look matters more than the ratio.
 *
 * With no photograph uploaded the section renders its original light
 * treatment -- black type on the page ground -- rather than a full-width
 * placeholder block.
 */
interface Props {
  headingLevel?: 'h1' | 'h2';
  /** The `alicore-why` slot. Absent -> the original light treatment. */
  image?: SlotImageType;
}

const { headingLevel = 'h2', image } = Astro.props;
const Heading = headingLevel;
const hasPhoto = Boolean(image);
---

<section class={`al-section al-why${hasPhoto ? ' al-why--photo' : ''}`}>
  {
    hasPhoto && (
      <div class="al-why__bg" aria-hidden="true">
        <SlotImage
          slot="alicore-why"
          placeholder="Wide architectural photograph used behind the Why Choose Alicore section"
          image={image}
          ratio="16/9"
          fit="cover"
          sizes="100vw"
          class="al-why__slot"
        />
      </div>
    )
  }

  <div class="al-container al-why__inner">
    <Eyebrow label="Why Alicore" ground={hasPhoto ? 'shaded' : 'light'} />
    <Heading class="al-why__title">Why Choose Alicore?</Heading>

    <div class="al-hairline-grid al-why__grid">
      {
        why.map((w) => (
          <div class="al-why__card">
            <div class="al-why__idx">{w.idx}</div>
            <h3 class="al-why__name">{w.name}</h3>
            <p class="al-why__desc">{w.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .al-why {
    position: relative;
    isolation: isolate;
  }

  /* --- the photograph ---------------------------------------------------
     Absolutely positioned so it is a background layer: the container is the
     only thing in flow, so the section stays self-sizing however tall the
     copy becomes. Same approach as MediaStage. */
  .al-why__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--color-ink-2);
    z-index: 0;
  }

  /* height:100% against a min-height-only parent resolves to auto and lets
     the photograph's own ratio drive the section height. Filling absolutely
     is what keeps it a background rather than content. */
  .al-why__bg :global(.al-slot) {
    position: absolute;
    inset: 0;
    height: auto;
    aspect-ratio: auto;
  }

  /* The only tint on the picture, and it is gone by the time the cards
     start. The heading has no card behind it, so it needs the photograph
     under it to be predictable; the sky is also the part of an
     architectural photograph least worth protecting. */
  .al-why__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(18 17 15 / 0.62) 0%,
      rgb(18 17 15 / 0.52) 20%,
      rgb(18 17 15 / 0.34) 34%,
      rgb(18 17 15 / 0) 50%
    );
  }

  .al-why__inner {
    position: relative;
    z-index: 1;
  }

  .al-why__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(30px, 3.8vw, 50px);
    line-height: 1.08;
    margin-top: 20px;
  }

  /* Three across, so the six reasons fill two complete rows. auto-fit alone
     resolves to four columns on a desktop and leaves two empty cells inside
     the grid's border -- invisible against the flat page ground this section
     used to have, but a pair of holes once a photograph shows through them. */
  .al-why__grid {
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    margin-top: 52px;
  }

  @media (min-width: 1000px) {
    .al-why__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .al-why__card {
    background: var(--color-bg);
    padding: 40px 34px 44px;
    transition: background-color 0.3s var(--ease-premium);
  }

  .al-why__card:hover {
    background: var(--color-panel);
  }

  .al-why__idx {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--color-gold-ink);
  }

  .al-why__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 21px;
    margin-top: 20px;
    line-height: 1.2;
  }

  .al-why__desc {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--color-on-light-60);
    margin-top: 14px;
  }

  /* --- over a photograph -------------------------------------------------
     Dark glass: enough to hold type, transparent enough that the picture
     reads straight through it. The blur is doing as much work as the tint --
     it removes the detail behind the type without removing the colour, so
     the card still looks like the photograph rather than like a panel. */
  .al-why--photo .al-why__card {
    background: rgb(18 17 15 / 0.44);
    -webkit-backdrop-filter: blur(18px) saturate(1.08);
    backdrop-filter: blur(18px) saturate(1.08);
  }

  .al-why--photo .al-why__card:hover {
    background: rgb(18 17 15 / 0.56);
  }

  .al-why--photo .al-why__title {
    color: var(--color-on-dark);
  }

  /* Full-strength warm white, not the -80/-60 steps used on solid grounds:
     over the brightest backdrop the glass can sit on, -80 measures 3.6:1
     and full 4.7:1. */
  .al-why--photo .al-why__name,
  .al-why--photo .al-why__desc,
  .al-why--photo .al-why__idx {
    color: var(--color-on-dark);
  }

  .al-why--photo .al-why__idx {
    opacity: 0.92;
  }

  /* Light hairlines, since the grid now sits on dark glass. */
  .al-why--photo .al-why__grid {
    background: rgb(246 244 239 / 0.22);
    border-color: rgb(246 244 239 / 0.22);
  }

  /* Without backdrop-filter the tint alone has to carry the type, so it goes
     up. Contrast improves; only the sharpness of the picture through the
     card is lost. */
  @supports not (backdrop-filter: blur(1px)) {
    .al-why--photo .al-why__card {
      background: rgb(18 17 15 / 0.62);
    }
  }

  /* Phones: the stacked cards make the section far taller than the 16:9
     photograph, so it crops to a narrow centre strip. Anchoring the image to
     its centre keeps the subject rather than the sky or the ground. */
  @media (max-width: 640px) {
    .al-why__bg :global(img) {
      object-position: center;
    }

    .al-why--photo .al-why__card {
      padding: 32px 26px 36px;
    }
  }
</style>
