# Cache rules for the Worker's static assets.
#
# The default Workers Assets header is `public, max-age=0, must-revalidate`,
# which only works if the response carries a validator. Files do -- they come
# back with an ETag. The documents the Worker returns do not, so Cloudflare
# cached a page at the edge, had nothing to revalidate it against, and went on
# serving it after a deploy. Staff kept seeing old copy and old photographs
# until they hard-refreshed, and that was only fixing their own browser, not
# the edge copy everyone else was being served.
#
# Documents are therefore never stored, and content-hashed build output is
# stored for a year.
#
# One rule per route rather than a `/*` catch-all: Cloudflare MERGES the
# headers of every matching rule instead of letting the more specific one win,
# so a catch-all no-store would join onto /_astro's immutable and win there
# too. Routes are listed in `find dist -name '*.html'` order; a new page needs
# a line here. Anything under /admin is rendered by the Worker and already
# sets no-store in middleware.ts.

/
  Cache-Control: no-store
/404.html
  Cache-Control: no-store
/about
  Cache-Control: no-store
/contact
  Cache-Control: no-store
/custom-solutions
  Cache-Control: no-store
/frp
  Cache-Control: no-store
/gfrc
  Cache-Control: no-store
/manufacturing
  Cache-Control: no-store
/products
  Cache-Control: no-store
/products/*
  Cache-Control: no-store

# Astro writes the content hash into the filename, so a changed file is a new
# URL and the old one is never asked for again.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
