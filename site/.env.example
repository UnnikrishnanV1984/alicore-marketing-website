# ---------------------------------------------------------------------------
# Public (safe to expose to the browser -- inlined into the built bundle)
# ---------------------------------------------------------------------------
PUBLIC_SITE_URL=https://www.alicore.in
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# Business contact details. Kept in env so the [ADD EMAIL] / [ADD ADDRESS]
# placeholders can be filled without a code change (see plan section 11).
PUBLIC_PHONE_DISPLAY=9995 495 395
PUBLIC_PHONE_E164=+919995495395
PUBLIC_WHATSAPP_E164=919995495395
PUBLIC_EMAIL=
PUBLIC_ADDRESS=

# ---------------------------------------------------------------------------
# Server-only secrets. Set with: wrangler secret put <NAME>
# NEVER prefix these with PUBLIC_ and never import them into a client island.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
ENQUIRY_NOTIFY_TO=
ENQUIRY_FROM=Alicore Website <website@alicore.in>
IP_HASH_SALT=

# Cloudflare cache purge on media upload (plan section 4)
CF_ZONE_ID=
CF_PURGE_TOKEN=
